reference_frame 150
name Monitor_Tracker4
xpos -300
ypos 330
}
StickyNote {
inputs 0
name README_Note
label "TAPTRACK on real footage (monitors.mp4, 232 frames @ 25 fps)\nViewer 1 = Merge_Monitor: a RED checkerboard locked to the video wall (CornerPin2D from TAPTrack_Wall, ref frame 1)\nand a BLUE checkerboard locked to the desk monitor's document panel (CornerPin2D from TAPTrack_Monitor, ref frame 150).\nThe wall leaves the top of the frame around frame 90; the monitor enters from the bottom around frame 20.\nMerge mix is linked to Wall_CornerPin_valid / Monitor_CornerPin_valid (1 = reliable fit, 0 = element off).\nSelect Wall_Tracker4 / Monitor_Tracker4 to see every tracked point; select a TAPTrack node to re-Track or re-Export."
xpos -698
ypos -375
}
Rectangle {
inputs 0
area {610 495 1550 1020}
name TAPTrack_Wall_Mask
xpos -329
ypos -151
}
push $Nd94bc500
Group {
inputs 2
name TAPTrack_Wall
onCreate "import taptrack.node as _n; _n.refresh_status(nuke.thisNode())"
knobChanged "import taptrack.node as _n; _n.on_knob_changed(nuke.thisNode(), nuke.thisKnob())"
xpos -120
ypos -129
addUserKnob {20 tt_tracking l Tracking}
addUserKnob {4 model t "BootsTAPNext: best default, runs at 256x256.\nBootsTAPIR (offline): runs at 512x512, slower.\nTAPNext: older checkpoint, for comparison. BootsTAPIR (online): causal, slow with many points." M {BootsTAPNext TAPNext "BootsTAPIR (offline)" "BootsTAPIR (online)"}}
addUserKnob {3 first l "frame range"}
first 1
addUserKnob {3 last l "" -STARTLINE}
last 232
addUserKnob {22 set_range l "Set from input" t "Use the plate's frame range." -STARTLINE T "import taptrack.node as _n; _n.set_range_from_input(nuke.thisNode())"}
addUserKnob {3 ref_frame l "reference frame"}
ref_frame 1
addUserKnob {22 set_ref l "Current frame" t "Track from the frame shown in the viewer." -STARTLINE T "import taptrack.node as _n; _n.set_ref_to_current(nuke.thisNode())"}
addUserKnob {4 work_res l "working resolution" t "Frames are squashed to a square of this size for the network. Auto = the model's native size (256 for TAPNext, 512 for TAPIR). TAPNext is fixed at 256." M {Auto 256 384 512 Custom}}
addUserKnob {3 work_custom l "custom size"}
work_custom 512
addUserKnob {26 div1 l "" +STARTLINE}
addUserKnob {4 query_source l "points from" M {Tracker4 "Grid in mask" "Full-frame grid"}}
query_source "Grid in mask"
addUserKnob {1 tracker_node l "Tracker4 node"}
addUserKnob {22 pick_tracker l "Pick selected" t "Use the selected Tracker4's tracks at the reference frame." -STARTLINE T "import taptrack.node as _n; _n.pick_tracker(nuke.thisNode())"}
addUserKnob {3 grid_spacing l "grid spacing (px)"}
grid_spacing 70
addUserKnob {3 max_points l "max points"}
max_points 300
addUserKnob {26 div2 l "" +STARTLINE}
addUserKnob {22 track l Track t "Render the plate, run the tracker, keep the result in the script." -STARTLINE T "import taptrack.node as _n; _n.on_track(nuke.thisNode())"}
addUserKnob {22 cancel l Cancel t "Stop the running track." -STARTLINE T "import taptrack.node as _n; _n.on_cancel(nuke.thisNode())"}
addUserKnob {22 clear_cache l "Clear cache" t "Delete the cached frames and result for this setup." -STARTLINE T "import taptrack.node as _n; _n.on_clear_cache(nuke.thisNode())"}
addUserKnob {1 status +DISABLED}
status "91 points | 30.7% visible | 17.7 s | bootstapnext"
addUserKnob {20 tt_export l Export}
addUserKnob {4 out_type l output t "Tracker4: every tracked point. CornerPin2D: four anchors (all points feed a robust fit). Transform: one motion fitted to all points, as a matchmove or a stabilize." M {Tracker4 CornerPin2D "Transform - Matchmove" "Transform - Stabilize"}}
out_type CornerPin2D
addUserKnob {4 fit_model l "transform model" M {Translate Translate+Rotate+Scale Affine}}
fit_model Affine
addUserKnob {6 ransac l "reject outliers (RANSAC)" t "Fit on the points that agree with each other on each frame. Switch off only to compare." -STARTLINE}
ransac true
addUserKnob {6 prefer_continuous l "ignore re-acquired points when possible" t "Points that were occluded and found again can come back slightly offset. Use only points that stayed visible since the reference frame, unless there are too few." -STARTLINE}
prefer_continuous true
addUserKnob {4 smoothing M {none Gaussian}}
addUserKnob {3 smooth_frames l "smooth (frames)"}
smooth_frames 3
addUserKnob {1 pin_points l "corner pin points" t "Four point numbers (as in the Tracker4 rows, 1-based), e.g. '3 17 40 8'. Empty = pick four well-spread, reliable points automatically."}
addUserKnob {6 robust_pin l "corner pin from all points" t "On: the corners follow a homography fitted to every point (survives occlusion). Off: the corners follow the four raw tracks." -STARTLINE}
robust_pin true
addUserKnob {22 export l Export t "Create the node below this one." -STARTLINE T "import taptrack.node as _n; _n.on_export(nuke.thisNode())"}
addUserKnob {20 tt_settings l Settings}
addUserKnob {1 worker_python l "worker Python"}
worker_python L:/Nuke/tools/taptrack/.venv/Scripts/python.exe
addUserKnob {1 cache_dir l "cache folder"}
cache_dir L:/Nuke_cache/taptrack_cache
addUserKnob {4 device M {auto cuda cpu}}
addUserKnob {4 precision M {fp16 bf16 fp32}}
addUserKnob {1 ocio_in l "OCIO in"}
ocio_in scene_linear
addUserKnob {1 ocio_out l "OCIO out" t "The models were trained on display-referred sRGB video, so the plate is converted from scene-linear to sRGB before tracking."}
ocio_out sRGB
addUserKnob {1 result_path +INVISIBLE}
result_path L:/Nuke_cache/taptrack_cache/4dcd55740753acccc793/result.json
addUserKnob {1 worker_pid +INVISIBLE}
addUserKnob {1 cancelled +INVISIBLE}
}
Input {
inputs 0
name mask
xpos 150
number 1
}
Input {
inputs 0
name plate
xpos 0
}
set Nd94ad200 [stack 0]
Reformat {
type "to box"
box_width 256
box_height 256
box_fixed true
resize distort
name tt_reformat
xpos 0
ypos 80
}
OCIOColorSpace {
in_colorspace scene_linear
out_colorspace sRGB
name tt_colorspace
xpos 0
ypos 140
}
Write {
file L:/Nuke_cache/taptrack_cache/4dcd55740753acccc793/frames/f.%04d.png
file_type png
colorspace linear
checkHashOnRead false
version 1
in_colorspace scene_linear
out_colorspace scene_linear
ocioColorspace scene_linear
display default
view sRGB
name tt_write
xpos 0
ypos 200
}
push $Nd94ad200
Output {
name Output1
xpos -150
ypos 200
}
end_group
