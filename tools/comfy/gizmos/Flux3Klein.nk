# Flux3Klein - paint, replace or erase part of one frame through ComfyUI (FLUX 3 Image Klein, json/Flux3Klein.json)
# Generated by build/build_flux3klein.py: edit that script and rebuild, not this file.
# Generate crops the current frame around the edit mask (plus context), sends it as a half-float EXR in the script's
# working space with the mask in alpha, and Klein repaints only under the mask. Fit to Plate matches colour and grain,
# big crops come back through SeedVR2, and the patch is keymixed over the untouched Source through the grown +
# feathered mask held at the generated frame. Every result is kept: pick one in Version.
# Inputs: Source, Mask (Roto, a keyer...: pick the channel), Strokes (RGBA paint as a guide), Ref1-Ref4.
# Needs NukeComfy on the plugin path and a ComfyUI (COMFY_URL) with ComfyUI-EXR-ACEScg, ComfyUI-PlateFit,
# ainvfx-paintaplate and SeedVR2. Without them the group still evaluates and shows the last result.
# Target: Nuke 16.1. Import with the NukeComfy menu or nuke.nodePaste(path).
set cut_paste_input [stack 0]
version 16.1 v4
push $cut_paste_input
Group {
 name Flux3Klein
 knobChanged "try:\n    import NukeComfy.python.flux3klein as f\n    f.knob_changed(nuke.thisNode(), nuke.thisKnob())\nexcept ImportError:\n    pass"
 tile_color 0x4a7a9bff
 label "\[value status]"
 selected true
 addUserKnob {20 edit_tab l Edit}
 addUserKnob {1 template l "" +STARTLINE +INVISIBLE}
 template Flux3Klein
 addUserKnob {4 mode l Mode t "Replace or add: Klein paints what the prompt describes inside the mask.\nErase: removes what is inside the mask and continues the background (the prompt can name the object)." M {"Replace or add" Erase}}
 addUserKnob {43 prompt_pos l Prompt t "What to paint inside the mask (Replace), or what to remove (Erase, optional). Just the object: the tool writes the full instruction for Klein. Ref1 is <ref_image_1> ... Ref4 is <ref_image_4> if you use them."}
 prompt_pos "a bright red enamel star emblem"
 addUserKnob {41 mask_channel l "Mask channel" t "Channel of the Mask input that marks the edit (white = edit)." T MaskSel.from0}
 addUserKnob {3 seed l Seed}
 seed 7
 addUserKnob {3 steps l Steps t "Steps of the first Klein pass. 16 is the distilled model's own setting." -STARTLINE}
 steps 16
 addUserKnob {3 edit_grow l "Edit grow (px)" t "How far around the mask Klein may repaint, in working pixels (Size tab). Needs a new Generate."}
 edit_grow 16
 addUserKnob {26 edit_div l "" +STARTLINE}
 addUserKnob {22 generate l Generate -STARTLINE T "import NukeComfy.python.flux3klein\nNukeComfy.python.flux3klein.generate(nuke.thisNode())"}
 addUserKnob {6 show_result l "Show result" -STARTLINE}
 show_result true
 addUserKnob {4 version l Version t "Every Generate adds a version; pick the one to show." M {" "}}
 addUserKnob {1 status l Status}
 status Idle
 addUserKnob {6 has_result l "" -STARTLINE +INVISIBLE}
 addUserKnob {1 versions_data l "" +STARTLINE +INVISIBLE}
 versions_data "\[]"
 addUserKnob {3 patch_x l "" +STARTLINE +INVISIBLE}
 addUserKnob {3 patch_y l "" +STARTLINE +INVISIBLE}
 addUserKnob {3 patch_frame l "" +STARTLINE +INVISIBLE}
 addUserKnob {20 strokes_tab l Strokes}
 addUserKnob {6 use_strokes l "Use strokes" t "Paint a rough shape in colour (RotoPaint, RGBA) into the Strokes input: Klein turns it into what the prompt says, keeping its shape and colours. The strokes' alpha is added to the edit mask." -STARTLINE}
 use_strokes true
 addUserKnob {26 strokes_info l "" +STARTLINE T "Connect RGBA strokes to the Strokes input (e.g. a RotoPaint on black).\nThey are merged over Source for Klein; the plate itself is not changed."}
 addUserKnob {20 refs_tab l References}
 addUserKnob {26 refs_info l "" +STARTLINE T "Connect up to 4 images to Ref1-Ref4 (a product, a texture, a look).\nName them in the prompt: 'the jacket from <ref_image_1>'.\nEach is sent at about 1 MP; every reference adds time."}
 addUserKnob {20 size_tab l Size}
 addUserKnob {4 region l Region t "Crop to mask sends only the mask's area plus context, so a small edit on a 4K plate keeps full detail." M {"Crop to mask" "Full frame"}}
 addUserKnob {7 context l "Context (%)" t "Area around the mask sent with it, in % of the mask's size (at least 64 px). More context: better fit, less detail." R 0 200}
 context 50
 addUserKnob {7 megapixels l "Working size (MP)" t "Size Klein refines at. The crop is scaled to it and back. On a 12 GB RTX 3060 a 2 MP edit takes about a minute." R 0.5 4}
 megapixels 2
 addUserKnob {7 refine l "Refine strength" t "Klein works in two passes: a quick one at about 0.6 MP finds the edit, then a refine at the working size\nredraws it with this much freedom (8 steps). Lower keeps the quick pass, higher adds detail and change." R 0.1 0.8}
 refine 0.35
 addUserKnob {4 upscale l Upscale t "Back to the crop's size. Auto uses SeedVR2 when the crop is more than 1.25x the working size, else a resize." M {Auto SeedVR Resize}}
 addUserKnob {4 seedvr_model l "SeedVR model" t "3B GGUF fits the card. 7B sharp is 16 GB and streams from RAM: much slower." M {"3B (fast)" "7B sharp (slow)"}}
 addUserKnob {20 colour_tab l Colour}
 addUserKnob {4 color l "Plate primaries" t "Primaries of the script's working space (the tool always sends scene-linear data, untouched).\nAuto: ACEScg when the OCIO working space is ACEScg, else Linear Rec.709 (Nuke's default 'linear')." M {Auto ACEScg "Linear Rec.709"}}
 addUserKnob {4 match_color l "Colour match" t "Match the edit's colour and exposure to the plate at its edge. Auto: on for Replace, off for Erase." M {Auto On Off}}
 addUserKnob {7 grain l Grain t "Add grain up to the plate's level. 0 adds none." R 0 2}
 grain 1
 addUserKnob {20 output_tab l Output}
 addUserKnob {3 comp_grow l "Grow (px)" t "Grows the mask used to comp the patch. No new Generate needed."}
 comp_grow 8
 addUserKnob {7 feather l "Feather (px)" t "Softens the comp edge. No new Generate needed." R 0 50}
 feather 6
}
 Input {
  inputs 0
  name Ref1
  xpos 900
  ypos -400
  number 3
 }
 Input {
  inputs 0
  name Ref2
  xpos 1020
  ypos -400
  number 4
 }
 Input {
  inputs 0
  name Ref3
  xpos 1140
  ypos -400
  number 5
 }
 Input {
  inputs 0
  name Ref4
  xpos 1260
  ypos -400
  number 6
 }
 Input {
  inputs 0
  name Strokes
  xpos 600
  ypos -400
  number 2
 }
set Nf70b0900 [stack 0]
 Input {
  inputs 0
  name Mask
  xpos 300
  ypos -400
  number 1
 }
set Nf70b0480 [stack 0]
push $Nf70b0480
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 rgba.alpha
  name MaskSel
  xpos 300
  ypos -320
 }
 Merge2 {
  inputs 2
  operation max
  Achannels alpha
  Bchannels alpha
  output alpha
  name EditMask
  xpos 300
  ypos -240
  disable {{!parent.use_strokes}}
 }
set Nf70d0500 [stack 0]
 Input {
  inputs 0
  name Source
  xpos 0
  ypos -400
 }
set Nf70b0000 [stack 0]
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 rgba.alpha
  name SendSource
  xpos 150
  ypos -160
 }
 Crop {
  reformat true
  name CropBox
  xpos 150
  ypos -80
 }
 NoOp {
  name SendCrop
  xpos 150
  ypos -20
 }
push $Nf70b0900
push $Nf70b0000
 Merge2 {
  inputs 2
  name Guide
  xpos 600
  ypos -160
 }
 Crop {
  box {{CropBox.box} {CropBox.box} {CropBox.box} {CropBox.box}}
  reformat true
  name GuideCrop
  xpos 600
  ypos -80
 }
push $Nf70d0500
 FrameHold {
  firstFrame {{parent.patch_frame}}
  name HoldMask
  xpos 300
 }
 FilterErode {
  channels alpha
  size {{-parent.comp_grow}}
  name Grow
  xpos 300
  ypos 60
 }
 Blur {
  channels alpha
  size {{parent.feather}}
  name Feather
  xpos 300
  ypos 120
 }
 Read {
  inputs 0
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Result
  xpos -200
  disable {{!parent.has_result}}
 }
 Transform {
  translate {{parent.patch_x} {parent.patch_y}}
  name Place
  xpos -200
  ypos 80
 }
push $Nf70b0000
 Keymix {
  inputs 3
  channels rgb
  name Comp
  xpos 0
  ypos 180
 }
push $Nf70b0000
 Switch {
  inputs 2
  which {{"parent.show_result * parent.has_result"}}
  name ShowResult
  xpos 0
  ypos 260
 }
 Output {
  name Output1
  xpos 0
  ypos 340
 }
end_group
