 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj0Read
  xpos 200
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj0Scale
  xpos 200
