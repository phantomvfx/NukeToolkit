# SAM3Matte - mattes, per-object channels and a Cryptomatte layer from SAM3 through ComfyUI (sam3.1 multiplex)
# Generated by build/build_sam3matte.py: edit that script and rebuild, not this file.
# Generate renders the plate, sends it to ComfyUI, tracks up to 8 objects and keeps the masks as 8-bit PNG sequences
# (obj<k>.####.png) in a version folder; the Group reads them back, so a result never needs ComfyUI again.
# Inputs: Source (the plate), Select (key frame only: its alpha marks what to segment, white = include), Stencil (its alpha marks what to leave out).
# Outputs (one stream): rgb = Source untouched; rgba.alpha = union of the chosen Objects, then Erode, Blur and the optional
# Hard stencil; sam.m0 .. sam.m7 = one raw mask per object; CryptoSAM00 (red, green, blue, alpha) + manifest metadata, so a
# Cryptomatte node after this Group picks objects by name. sam.* and CryptoSAM00 are raw (no erode, blur or stencil).
# SAM3Matte's alpha plugs into Flux3Klein's Mask input (Mask channel = alpha).
# Write EXRs as 32-bit float, channels 'all', metadata 'all metadata': half float cannot hold the Cryptomatte IDs and the
# default metadata setting drops the exr/cryptomatte/* lines the Cryptomatte node needs.
# Target: Nuke 16.1. Import with the NukeComfy menu, File > Import Script, or nuke.nodePaste(path). It is not in the node toolbar.
# Tested: headless in Nuke 16.1 (tests/nuke/test_sam3matte_group.py). The Generate button needs a ComfyUI (COMFY_URL).
set cut_paste_input [stack 0]
version 16.1 v4
push $cut_paste_input
Group {
 name SAM3Matte
 knobChanged "try:\n    import NukeComfy.python.sam3matte as s\n    s.knob_changed(nuke.thisNode(), nuke.thisKnob())\nexcept ImportError:\n    pass"
 tile_color 0x7a5a9bff
 label "\[value status]"
 selected true
 addUserKnob {20 sam3matte_tab l SAM3Matte}
 addUserKnob {4 mode l Mode t "Two ways SAM3 can work:\n\nFrom key frame (default)\n  Uses: Prompt, Select, Stencil, in any mix.\n  How: SAM3 Detect on the key frame, then track both ways.\n  Objects entering later: not found (generate again from a later key frame).\n  'person:2' caps: honoured.\n  Stencil: a hint (excludes points with Select; with text only, drops detected objects mostly inside Stencil) and an optional hard cut.\n\nWhole range\n  Uses: Prompt only.\n  How: SAM3 Video Track with text over the range, one forward pass.\n  Objects entering later: found as they enter.\n  'person:2' caps: ignored, only Max objects applies.\n  Stencil: hard cut only (forced on).\n\nWhole range with Select connected is an error: switch to From key frame." M {"From key frame" "Whole range"}}
 addUserKnob {1 prompt l Prompt t "What to matte, comma separated: person:2, ball:1\n':N' is the most objects to keep for that subject. The caps only work in From key frame mode (Whole range ignores them and uses Max objects). Max 32 tokens.\nEmpty is fine in From key frame mode if Select has strokes."}
 addUserKnob {3 max_objects l "Max objects" t "Most objects tracked (1 to 8). Each one is a mask sequence in the version folder and a sam.m channel." R 1 8}
 max_objects 4
 addUserKnob {6 source_range l "Source range" t "On: the Source's frame range. Off: type First and Last." +STARTLINE}
 source_range true
 addUserKnob {3 first l First +DISABLED}
 first 1
 addUserKnob {3 last l Last -STARTLINE +DISABLED}
 last 100
 addUserKnob {6 key_current l "Key at current frame" t "From key frame mode: the frame SAM3 detects on. On: the frame the Viewer is on when you press Generate. Off: type Key frame." +STARTLINE}
 key_current true
 addUserKnob {3 key_frame l "Key frame" +DISABLED}
 key_frame 1
 addUserKnob {3 tracking_width l "Tracking width" t "Width in pixels SAM3 tracks at (the key frame is sent at full size). Masks come back at this size and are scaled up to the plate here."}
 tracking_width 1024
 addUserKnob {3 chunk_size l "Chunk size" t "Frames per ComfyUI run. Long shots are cut into chunks that share a seed mask, so memory stays flat."}
 chunk_size 250
 addUserKnob {26 run_div l "" +STARTLINE}
 addUserKnob {22 generate l Generate -STARTLINE T "import NukeComfy.python.sam3matte\nNukeComfy.python.sam3matte.generate(nuke.thisNode())"}
 addUserKnob {22 cancel l Cancel -STARTLINE T "import NukeComfy.python.sam3matte\nNukeComfy.python.sam3matte.cancel(nuke.thisNode())"}
 addUserKnob {4 version l Version t "Every Generate adds a version; pick the one shown. A partial version can be resumed by generating again with the same settings." M {" "}}
 addUserKnob {1 status l Status}
 status Idle
 addUserKnob {20 matte_tab l Matte}
 addUserKnob {1 objects l Objects t "Which objects make up the alpha: all, or a comma list of slot numbers or object names (0, 2 or person_1, ball_1). Only the alpha follows this; sam.* and CryptoSAM00 always carry every object."}
 objects all
 addUserKnob {7 erode l Erode t "Shrinks the alpha, in pixels (negative grows). Alpha only." R -20 20}
 addUserKnob {7 blur l Blur t "Softens the alpha edge, in pixels. SAM3 edges are hard, so this is where they get soft. Alpha only." R 0 50}
 addUserKnob {6 hard_stencil l "Hard stencil" t "Also cut the Stencil input's alpha (held at the key frame) out of the final alpha. Off: in From key frame mode Stencil is only a hint to SAM3. Always on in Whole range mode." +STARTLINE}
 addUserKnob {26 matte_div l "" +STARTLINE}
 addUserKnob {22 make_roto l "Make Roto" t "Builds an animated Roto node next to the Group from the current version's saved masks. No ComfyUI needed." -STARTLINE T "import NukeComfy.python.sam3matte_roto\nNukeComfy.python.sam3matte_roto.make_roto(nuke.thisNode())"}
 addUserKnob {3 roto_points l "Points per shape" t "Make Roto: points per shape (the same count on every frame)."}
 roto_points 32
 addUserKnob {3 roto_step l "Key every N frames" t "Make Roto: a key every N frames."}
 roto_step 1
 addUserKnob {1 versions_data l "" +STARTLINE +INVISIBLE}
 versions_data "\[]"
 addUserKnob {6 has_result l "" -STARTLINE +INVISIBLE}
 addUserKnob {3 stencil_frame l "" +STARTLINE +INVISIBLE}
 addUserKnob {3 mask_first l "" +STARTLINE +INVISIBLE}
 addUserKnob {3 mask_last l "" +STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present0 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present1 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present2 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present3 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present4 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present5 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present6 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_present7 l "" -STARTLINE +INVISIBLE}
 addUserKnob {6 obj_on0 l "" -STARTLINE +INVISIBLE}
 obj_on0 true
 addUserKnob {6 obj_on1 l "" -STARTLINE +INVISIBLE}
 obj_on1 true
 addUserKnob {6 obj_on2 l "" -STARTLINE +INVISIBLE}
 obj_on2 true
 addUserKnob {6 obj_on3 l "" -STARTLINE +INVISIBLE}
 obj_on3 true
 addUserKnob {6 obj_on4 l "" -STARTLINE +INVISIBLE}
 obj_on4 true
 addUserKnob {6 obj_on5 l "" -STARTLINE +INVISIBLE}
 obj_on5 true
 addUserKnob {6 obj_on6 l "" -STARTLINE +INVISIBLE}
 obj_on6 true
 addUserKnob {6 obj_on7 l "" -STARTLINE +INVISIBLE}
 obj_on7 true
}
 Input {
  inputs 0
  name Select
  label "alpha marks what to segment (white = include), key frame"
  xpos 1500
  ypos -400
  number 1
 }
 Input {
  inputs 0
  name Stencil
  label "alpha marks what to leave out"
  xpos 1700
  ypos -400
  number 2
 }
 FrameHold {
  firstFrame {{parent.stencil_frame}}
  name StencilHold
  xpos 1700
  ypos -320
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj7Read
  xpos 1320
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj7Scale
  xpos 1320
  ypos -260
 }
 Input {
  inputs 0
  name Source
  xpos 0
  ypos -400
 }
set N4742000 [stack 0]
 Multiply {
  value 0
  name Black
  xpos -200
  ypos -300
 }
set N4754000 [stack 0]
 Switch {
  inputs 2
  which {{parent.obj_present7}}
  name Obj7Slot
  xpos 1320
  ypos -200
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj6Read
  xpos 1160
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj6Scale
  xpos 1160
  ypos -260
 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present6}}
  name Obj6Slot
  xpos 1160
  ypos -200
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj5Read
  xpos 1000
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj5Scale
  xpos 1000
  ypos -260
 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present5}}
  name Obj5Slot
  xpos 1000
  ypos -200
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj4Read
  xpos 840
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj4Scale
  xpos 840
  ypos -260
 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present4}}
  name Obj4Slot
  xpos 840
  ypos -200
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj3Read
  xpos 680
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj3Scale
  xpos 680
  ypos -260
 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present3}}
  name Obj3Slot
  xpos 680
  ypos -200
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj2Read
  xpos 520
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj2Scale
  xpos 520
  ypos -260
 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present2}}
  name Obj2Slot
  xpos 520
  ypos -200
 }
 Read {
  inputs 0
  before black
  after black
  on_error black
  raw true
  in_colorspace scene_linear
  out_colorspace scene_linear
  name Obj1Read
  xpos 360
  ypos -320
 }
 Reformat {
  type "to box"
  box_width {{Source.width}}
  box_height {{Source.height}}
  box_fixed true
  resize distort
  filter linear
  name Obj1Scale
  xpos 360
  ypos -260
 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present1}}
  name Obj1Slot
  xpos 360
