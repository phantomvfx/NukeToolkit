 }
push $N4754000
 Switch {
  inputs 2
  which {{parent.obj_present0}}
  name Obj0Slot
  xpos 200
  ypos -200
 }
push $N4742000
add_layer {sam sam.m0 sam.m1 sam.m2 sam.m3 sam.m4 sam.m5 sam.m6 sam.m7}
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m0
  name Obj0Copy
  xpos 200
  ypos -120
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m1
  name Obj1Copy
  xpos 360
  ypos -80
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m2
  name Obj2Copy
  xpos 520
  ypos -40
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m3
  name Obj3Copy
  xpos 680
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m4
  name Obj4Copy
  xpos 840
  ypos 40
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m5
  name Obj5Copy
  xpos 1000
  ypos 80
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m6
  name Obj6Copy
  xpos 1160
  ypos 120
 }
 Copy {
  inputs 2
  from0 rgba.red
  to0 sam.m7
  name Obj7Copy
  xpos 1320
  ypos 160
 }
add_layer {CryptoSAM00 CryptoSAM00.red CryptoSAM00.green CryptoSAM00.blue CryptoSAM00.alpha}
 Expression {
  channel0 {CryptoSAM00.red -CryptoSAM00.green -CryptoSAM00.blue none}
  expr0 0
  channel1 {-CryptoSAM00.red CryptoSAM00.green -CryptoSAM00.blue none}
  expr1 0
  channel2 {-CryptoSAM00.red -CryptoSAM00.green CryptoSAM00.blue none}
  expr2 0
  channel3 {-CryptoSAM00.red -CryptoSAM00.green -CryptoSAM00.blue none}
  expr3 0
  name CryptoExpr
  xpos 0
  ypos 100
 }
set N334eed00 [stack 0]
 Expression {
  channel0 alpha
  expr0 "\[value CryptoExpr.expr3]"
  channel1 none
  channel2 none
  channel3 none
  name CryptoCov1
  xpos 0
  ypos 160
 }
push $N334eed00
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 CryptoSAM00.alpha
  name CryptoAlpha
  xpos 0
  ypos 220
 }
 Expression {
  channel0 none
  channel1 none
  channel2 none
  channel3 alpha
  expr3 "max(parent.obj_on0 * sam.m0, parent.obj_on1 * sam.m1, parent.obj_on2 * sam.m2, parent.obj_on3 * sam.m3, parent.obj_on4 * sam.m4, parent.obj_on5 * sam.m5, parent.obj_on6 * sam.m6, parent.obj_on7 * sam.m7)"
  name Union
  xpos 0
  ypos 300
 }
 FilterErode {
  channels alpha
  size {{parent.erode}}
  name Erode
  xpos 0
  ypos 360
 }
 Blur {
  channels alpha
  size {{parent.blur}}
  name Soften
  xpos 0
  ypos 420
 }
set N33574f00 [stack 0]
 Merge2 {
  inputs 2
  operation stencil
  name StencilCut
  xpos 0
  ypos 480
  disable {{"!(parent.hard_stencil || parent.mode == 1)"}}
 }
push $N33574f00
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 rgba.alpha
  name StencilAlpha
  xpos 0
  ypos 520
 }
 ModifyMetaData {
  metadata {
   {set exr/cryptomatte/f7b3802/name CryptoSAM}
   {set exr/cryptomatte/f7b3802/hash MurmurHash3_32}
   {set exr/cryptomatte/f7b3802/conversion uint32_to_float32}
   {set exr/cryptomatte/f7b3802/manifest "\{\}"}
  }
  name CryptoMeta
  xpos 0
  ypos 620
 }
 Output {
  name Output1
  xpos 0
  ypos 700
 }
end_group
