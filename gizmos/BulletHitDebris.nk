# BulletHitDebris -- particle debris + dust spray burst for a bullet hit   (target: Nuke 16)
# Import: nuke.nodePaste("<path>/BulletHitDebris.nk"), File > Import Script, or paste
#         this text into the Node Graph. NOT a .gizmo -- it will not be in the toolbar.
# Inputs: img  plate (sets the output format)
#         cam  shot camera. Connect one: Nuke's default camera sits inside the burst.
#              No solve? Use any Camera looking at the table and place by eye.
#         axis optional parent for the placement, e.g. an Axis / CameraTracker locator on the table
# Output: img with the burst merged over, or the premultiplied burst alone ("output" knob).
# Timing: impact_frame = impact, +1..+4 main throw, fade to 0 by impact+8 (life knob).
# Space : hit at origin, table = y=0 plane, +Y up, 1 unit = 1 m. Use "scene scale" for cm scenes.
# Needs: NukeX / Nuke Studio licence (particle nodes), on the farm too.
# Velocities and gravity are per frame, tuned for 24 fps.
# Paste one per hit; give each its own impact_frame and seed.
# Status: tested headless in Nuke 16.1v4 on a synthetic table shot; not yet on a real plate.
# Generated by python/build_bullet_hit_debris.py -- edit the script, not this file.
set cut_paste_input [stack 0]
version 16.1 v4
push $cut_paste_input
Group {
 name BulletHitDebris
 selected true
 addUserKnob {20 tab_main l BulletHitDebris}
 addUserKnob {3 impact_frame l "impact frame" t "Frame the bullet lands. Every particle is born in this frame."}
 impact_frame 1
 addUserKnob {3 seed t "Change per hit so two hits never look the same."}
 seed 1
 addUserKnob {4 output -STARTLINE M {"comp over img" "burst only"}}
 addUserKnob {26 div_place l Placement}
 addUserKnob {41 place_translate l position T Placement.translate}
 addUserKnob {41 place_rotate l "surface rotate" T Placement.rotate}
 addUserKnob {41 place_scale l "scene scale" T Placement.uniform_scale}
 addUserKnob {13 throw_dir l "throw tilt" t "Tilts the burst away from the surface normal (degrees). Lean it back toward the shooter for an angled hit."}
 addUserKnob {26 div_debris l "Debris (chips / splinters)"}
 addUserKnob {7 debris_count l amount t "Chips in the burst." R 0 800}
 debris_count 150
 addUserKnob {7 debris_speed l speed t "Metres per frame at birth." R 0 0.4}
 debris_speed 0.06
 addUserKnob {7 debris_size l size t "Chip size, metres." R 0 0.05}
 debris_size 0.012
 addUserKnob {7 debris_spread l spread t "0 = straight up the normal, 1 = wide."}
 debris_spread 0.4
 addUserKnob {7 debris_spin l spin t "Tumble rate." R 0 120}
 debris_spin 40
 addUserKnob {7 debris_bounce l bounce t "How much chips bounce off the table."}
 debris_bounce 0.3
 addUserKnob {18 debris_color l colour}
 debris_color {0.32 0.2 0.11}
 addUserKnob {7 debris_fade l "fade starts" t "Frames after impact where debris starts to fade." R 0 12}
 debris_fade 4
 addUserKnob {26 div_spray l "Spray (dust)"}
 addUserKnob {7 spray_count l amount t "Dust particles in the burst." R 0 4000}
 spray_count 1200
 addUserKnob {7 spray_speed l speed t "Metres per frame at birth." R 0 0.6}
 spray_speed 0.09
 addUserKnob {7 spray_size l size t "Dust particle size, metres." R 0 0.05}
 spray_size 0.007
 addUserKnob {7 spray_spread l spread}
 spray_spread 0.35
 addUserKnob {7 spray_drag l drag t "Slows the dust down fast after the hit."}
 spray_drag 0.4
 addUserKnob {7 puff_count l "impact puff" t "Slow, larger dust right at the hit point: the impact-frame read." R 0 300}
 puff_count 80
 addUserKnob {7 puff_size l "puff size" R 0 0.1}
 puff_size 0.04
 addUserKnob {18 spray_color l colour}
 spray_color {0.6 0.53 0.45}
 addUserKnob {7 spray_opacity l opacity}
 spray_opacity 0.7
 addUserKnob {7 spray_fade l "fade starts" t "Frames after impact where dust starts to thin out." R 0 12}
 spray_fade 2
 addUserKnob {26 div_sim l "Simulation / render"}
 addUserKnob {7 gravity t "1 = earth gravity at 24 fps, metres." R 0 3}
 gravity 1
 addUserKnob {7 life l "life (frames)" t "Frames from impact until everything has faded out." R 3 24}
 life 8
 addUserKnob {6 table_holdout l "table holdout" t "Invisible table top at y=0 that hides particles below the surface (e.g. with a strong throw tilt)." -STARTLINE}
 table_holdout true
 addUserKnob {41 mb_samples l "motion blur samples" T render.samples}
 addUserKnob {41 mb_shutter l shutter T render.shutter}
 addUserKnob {41 nudge_translate l "2D nudge" T nudge2d.translate}
}
 Input {
  inputs 0
  name cam
  xpos 1500
  ypos 600
  number 1
 }
