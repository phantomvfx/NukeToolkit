  name bg_black
  xpos 0
  ypos 500
 }
set Ncac36000 [stack 0]
 ScanlineRender {
  inputs 3
  samples 10
  shutter 0.3
  shutteroffset centred
  name render
  xpos 500
  ypos 600
 }
 Multiply {
  channels rgb
  value {{parent.debris_color.r} {parent.debris_color.g} {parent.debris_color.b} 1}
  name debris_colour
  xpos 500
  ypos 680
 }
 Multiply {
  channels rgba
  value {{"(frame < parent.impact_frame ? 0 : clamp((parent.impact_frame + parent.life - frame) / max(1, parent.life - parent.debris_fade)))"}}
  name debris_fadeout
  xpos 500
  ypos 720
 }
