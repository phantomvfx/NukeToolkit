push 0
push 0
 ParticleEmitter {
  inputs 5
  start_frame {{"parent.impact_frame - 2"}}
  rate {{"frame >= parent.impact_frame - 1 && frame < parent.impact_frame ? parent.debris_count : 0"}}
  lifetime {{"parent.life + 2"}}
  velocity {{parent.debris_speed}}
  velocity_variation 0.75
  rotation_velocity {{parent.debris_spin}}
  rotation_velocity_variation 1
  size {{parent.debris_size}}
  size_variation 0.8
  spread {{parent.debris_spread}}
  seed {{"parent.seed * 13 + 1"}}
  rotate {{parent.throw_dir.x} {parent.throw_dir.y} {parent.throw_dir.z}}
  name emit_debris
  xpos 500
  ypos -100
 }
 ParticleDrag {
  drag 0.04
  rotational_drag 0.1
  name drag_debris
  xpos 500
 }
 ParticleGravity {
  to {0 {"-0.017 * parent.gravity"} 0}
  name gravity_debris
  xpos 500
  ypos 40
 }
 ParticleBounce {
  out_bounce {{parent.debris_bounce}}
  out_friction 0.5
  in_bounce {{parent.debris_bounce}}
  in_friction 0.5
  name table_bounce
  xpos 500
  ypos 80
 }
 ParticleSettings {
  steps_per_frame 3
  name sim_debris
  xpos 500
  ypos 120
 }
 MergeGeo {
  inputs 2
  name debris_and_table
  xpos 500
  ypos 400
 }
 TransformGeo {
  inputs 2
  name place_debris
  xpos 500
  ypos 480
 }
 Input {
  inputs 0
  name img
  xpos 0
  ypos -700
 }
set N9bd98000 [stack 0]
