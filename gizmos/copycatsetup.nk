addUserKnob {20 User}
addUserKnob {22 run_button l "Run Copcat" T "import nuke\nimport re\n\ndef create_ground_truth():\n    # Initialize global counters for \"GT_framehold\" and \"IN_framehold\" nodes\n    if not hasattr(create_ground_truth, \"gt_framehold_counter\"):\n        create_ground_truth.gt_framehold_counter = 0\n    if not hasattr(create_ground_truth, \"in_framehold_counter\"):\n        create_ground_truth.in_framehold_counter = 0\n\n    root = nuke.root()\n    read_node = None\n    current_node_context = None\n\n    try:\n        current_node_context = nuke.thisNode()\n    except NameError:\n        current_node_context = None\n\n    if current_node_context:\n        inp = current_node_context.input(0)\n        if inp and inp.Class() == \"Read\":\n            read_node = inp\n\n    if read_node is None and current_node_context:\n        if current_node_context.Class() != \"Group\":\n            try:\n                parent_of_context = current_node_context.parent()\n                if parent_of_context and parent_of_context.Class() == \"Group\":\n                    inp = parent_of_context.input(0)\n                    if inp and inp.Class() == \"Read\":\n                        read_node = inp\n            except Exception:\n                pass\n\n    if read_node is None:\n        with nuke.root():\n            selected_in_root = \[node for node in nuke.selectedNodes() if node.Class() == \"Read\"]\n        if selected_in_root:\n            read_node = selected_in_root\[0]\n\n    if read_node is None:\n        nuke.message(\"Please select a Read node.\")\n        return\n\n    old_selection = nuke.selectedNodes()\n    for node_sel in old_selection:\n        if node_sel: node_sel\['selected'].setValue(False)\n    if read_node: read_node\['selected'].setValue(True)\n\n    read_x = read_node.xpos()\n    read_width = read_node.screenWidth()\n    read_y = read_node.ypos()\n    read_height = read_node.screenHeight()\n\n    def create_node_in_root(node_class, framehold_prefix=None, **kwargs):\n        with nuke.root():\n            node = nuke.createNode(node_class, inpanel=False)\n        \n        node_name_to_set = None\n        if node_class == \"FrameHold\" and framehold_prefix in \[\"GT\", \"IN\"]:\n            counter_attr = f\"\{framehold_prefix.lower()\}_framehold_counter\"\n            current_counter_val = getattr(create_ground_truth, counter_attr)\n            \n            candidate_num = current_counter_val + 1\n            while True:\n                potential_name = f\"\{framehold_prefix\}_framehold\{candidate_num\}\"\n                if not nuke.toNode(potential_name):\n                    node_name_to_set = potential_name\n                    setattr(create_ground_truth, counter_attr, candidate_num)\n                    break\n                candidate_num += 1\n                if candidate_num > getattr(create_ground_truth, counter_attr) + 100000:\n                    print(f\"Warning: Could not find a unique name for \{framehold_prefix\}_framehold. Using fallback.\")\n                    import time\n                    fallback_base = f\"\{framehold_prefix\}_framehold_fallback_\{int(time.time())\}_\{candidate_num\}\"\n                    node_name_to_set = fallback_base\n                    fb_suffix = 1\n                    while nuke.toNode(node_name_to_set):\n                        node_name_to_set = f\"\{fallback_base\}_\{fb_suffix\}\"\n                        fb_suffix += 1\n                    setattr(create_ground_truth, counter_attr, candidate_num)\n                    break\n            try:\n                node\['name'].setValue(node_name_to_set)\n            except RuntimeError as e:\n                print(f\"Error setting FrameHold name '\{node_name_to_set\}': \{e\}. Node is \{node.name()\}\")\n        \n        elif 'name' in kwargs and kwargs\['name']:\n            original_name_arg = kwargs\['name']\n            current_name_to_try = original_name_arg\n            suffix_counter = 1\n            existing_node_with_name = nuke.toNode(current_name_to_try)\n            while existing_node_with_name and existing_node_with_name != node:\n                current_name_to_try = f\"\{original_name_arg\}_\{suffix_counter\}\"\n                suffix_counter += 1\n                existing_node_with_name = nuke.toNode(current_name_to_try)\n                if suffix_counter > 1000:\n                    print(f\"Warning: Could not find unique name for \{original_name_arg\} after 1000 tries.\")\n                    current_name_to_try = f\"\{original_name_arg\}_errSuffixHighCount_\{suffix_counter\}\"\n                    while nuke.toNode(current_name_to_try): \n                        suffix_counter += 1\n                        current_name_to_try = f\"\{original_name_arg\}_errSuffixHighCount_\{suffix_counter\}\"\n                    break\n            node_name_to_set = current_name_to_try\n            \n            if node.name() != node_name_to_set :\n                try:\n                    node\['name'].setValue(node_name_to_set)\n                except RuntimeError as e:\n                    print(f\"Warning: Could not set name for node \{node_name_to_set\}. Nuke error: \{e\}. Node is \{node.name()\}\")\n\n        for k,v in kwargs.items():\n            if k == 'xpos':\n                node.setXpos(int(round(v)))\n            elif k == 'ypos':\n                node.setYpos(int(round(v)))\n            elif k == 'name':\n                pass\n            else:\n                try:\n                    if k in \['bdwidth', 'bdheight']:\n                        node\[k].setValue(int(round(v)))\n                    else:\n                        node\[k].setValue(v)\n                except Exception:\n                    pass\n        return node\n\n    framerange_node = create_node_in_root(\"FrameRange\")\n    framerange_node.setXYpos(int(read_x), int(read_y + read_height + 50))\n    framerange_node\[\"first_frame\"].setValue(1)\n    framerange_node\[\"last_frame\"].setValue(1)\n    if read_node: framerange_node.setInput(0, read_node)\n\n    framerange_y = framerange_node.ypos()\n    framerange_h = framerange_node.screenHeight()\n    main_dot_x_center = int(round(read_x + read_width / 2.25)) \n    main_dot_y = int(round(framerange_y + framerange_h + 50))\n    main_dot = create_node_in_root(\"Dot\", name=\"Groundtruth_MainDot\")\n    main_dot.setXYpos(main_dot_x_center - int(main_dot.screenWidth()/2), main_dot_y) \n    main_dot.setInput(0, framerange_node)\n\n    panel = nuke.Panel(\"Ground Truth Setup\")\n    panel.addSingleLineInput(\"Number of ground truth frames:\", \"1\")\n    panel.addEnumerationPulldown(\"Mode:\", \"Retouch ROTO\")\n\n    if not panel.show():\n        for node_sel in old_selection:\n            if node_sel and node_sel.name() in nuke.allNodes(group=nuke.root()):\n                 node_sel\['selected'].setValue(True)\n        if main_dot and main_dot.name() in nuke.allNodes(group=nuke.root()): nuke.delete(main_dot)\n        if framerange_node and framerange_node.name() in nuke.allNodes(group=nuke.root()): nuke.delete(framerange_node)\n        return\n\n    num_frames_str = panel.value(\"Number of ground truth frames:\")\n    mode = panel.value(\"Mode:\")\n\n    if not num_frames_str.isdigit() or int(num_frames_str) < 1:\n        nuke.message(\"Invalid number of frames.\")\n        for node_sel in old_selection:\n            if node_sel and node_sel.name() in nuke.allNodes(group=nuke.root()):\n                 node_sel\['selected'].setValue(True)\n        if main_dot and main_dot.name() in nuke.allNodes(group=nuke.root()): nuke.delete(main_dot)\n        if framerange_node and framerange_node.name() in nuke.allNodes(group=nuke.root()): nuke.delete(framerange_node)\n        return\n    num_frames = int(num_frames_str)\n\n    first_frame_proj = int(nuke.root()\[\"first_frame\"].value())\n    last_frame_proj = int(nuke.root()\[\"last_frame\"].value())\n    total_frames_proj_duration = last_frame_proj - first_frame_proj + 1\n\n    frames_to_hold = \[]\n    if total_frames_proj_duration < 1:\n        frames_to_hold = \[1] * num_frames\n        if not frames_to_hold: frames_to_hold = \[1]\n    elif num_frames == 1:\n        frames_to_hold = \[int(round(first_frame_proj + (total_frames_proj_duration - 1) / 2.0))]\n    elif num_frames > 1 :\n        if total_frames_proj_duration == 1:\n             frames_to_hold = \[first_frame_proj] * num_frames\n        else:\n            step = float(total_frames_proj_duration - 1) / (num_frames - 1)\n            frames_to_hold = \[int(round(first_frame_proj + i * step)) for i in range(num_frames)]\n        frames_to_hold\[0] = first_frame_proj\n        frames_to_hold\[-1] = last_frame_proj\n        frames_to_hold = sorted(list(set(frames_to_hold)))\n        if not frames_to_hold and total_frames_proj_duration > 0:\n            frames_to_hold = \[int(round(first_frame_proj + (total_frames_proj_duration - 1) / 2.0))]\n        elif not frames_to_hold:\n            frames_to_hold = \[1]\n    else:\n         frames_to_hold = \[int(round(first_frame_proj + (total_frames_proj_duration-1) / 2.0))] if total_frames_proj_duration > 0 else \[1]\n\n    nodes_gt_for_backdrop = \[]\n    roto_nodes_gt = \[]\n    gt_columns = \[]\n\n    start_x_gt = main_dot.xpos() - 200 \n    spacing_gt = 150\n    \n    for i, frame_val in enumerate(frames_to_hold):\n        current_dot_x_gt_center = start_x_gt - i * spacing_gt \n\n        branch_dot_gt = create_node_in_root(\"Dot\", name=f\"Dot_GT_branch_\{frame_val\}_\{i+1\}\")\n        branch_dot_gt.setXYpos(current_dot_x_gt_center - int(branch_dot_gt.screenWidth()/2), main_dot_y)\n        branch_dot_gt.setInput(0, main_dot)\n\n        roto_y_pos = main_dot_y + 80 \n        fh_y_pos = roto_y_pos + 120 \n        \n        roto_node_name = f\"GT_Roto_\{frame_val\}_\{i+1\}\" \n        roto_node = None\n        if mode == \"Retouch\":\n            roto_node = create_node_in_root(\"RotoPaint\", name=roto_node_name)\n        else: \n            roto_node = create_node_in_root(\"Roto\", name=roto_node_name)\n            if \"replace\" in roto_node.knobs():\n                roto_node\[\"replace\"].setValue(True)\n\n        roto_node.setXYpos(current_dot_x_gt_center - int(roto_node.screenWidth()/2), roto_y_pos)\n        roto_node.setInput(0, branch_dot_gt)\n        roto_nodes_gt.append(roto_node)\n\n        fh = create_node_in_root(\"FrameHold\", framehold_prefix=\"GT\") \n        fh.setXYpos(current_dot_x_gt_center - int(fh.screenWidth()/2), fh_y_pos)\n        fh.setInput(0, roto_node)\n        fh\[\"firstFrame\"].setValue(frame_val)\n        \n        gt_columns.append(\{'dot': branch_dot_gt, 'roto': roto_node, 'fh': fh, 'frame': frame_val, 'id': i\})\n        nodes_gt_for_backdrop.extend(\[branch_dot_gt, roto_node, fh])\n\n    if len(gt_columns) > 1:\n        all_gt_column_nodes_for_flip = \[]\n        for col in gt_columns: all_gt_column_nodes_for_flip.extend(\[col\['dot'], col\['roto'], col\['fh']])\n        \n        min_x_overall_gt = min(n.xpos() for n in all_gt_column_nodes_for_flip)\n        max_x_overall_gt = max(n.xpos() + n.screenWidth() for n in all_gt_column_nodes_for_flip)\n        center_gt_x_axis = (min_x_overall_gt + max_x_overall_gt) / 2.0\n\n        for col_data in gt_columns:\n            for node_type_key in \['dot', 'roto', 'fh']:\n                node_to_flip = col_data\[node_type_key]\n                node_center_x = node_to_flip.xpos() + node_to_flip.screenWidth() / 2.0\n                mirrored_center_x = center_gt_x_axis + (center_gt_x_axis - node_center_x)\n                new_x_pos = int(round(mirrored_center_x - node_to_flip.screenWidth() / 2.0))\n                node_to_flip.setXpos(new_x_pos)\n    \n    gt_columns.sort(key=lambda c: c\['fh'].xpos())\n\n\n    nodes_in_for_backdrop = \[]\n    in_columns = \[]\n\n    start_x_in = main_dot.xpos() + main_dot.screenWidth() + 200 \n    spacing_in = 150 \n    previous_dot_for_in_branch = main_dot\n\n    for i, frame_val in enumerate(frames_to_hold):\n        current_dot_x_in_center = start_x_in + i * spacing_in\n\n        branch_dot_in = create_node_in_root(\"Dot\", name=f\"Dot_IN_branch_\{frame_val\}_\{i+1\}\")\n        branch_dot_in.setXYpos(current_dot_x_in_center - int(branch_dot_in.screenWidth()/2), main_dot_y)\n        branch_dot_in.setInput(0, previous_dot_for_in_branch)\n        previous_dot_for_in_branch = branch_dot_in\n\n        fh_y_final_in = main_dot_y + 200 \n\n        fh_in = create_node_in_root(\"FrameHold\", framehold_prefix=\"IN\") \n        fh_in.setXYpos(current_dot_x_in_center - int(fh_in.screenWidth()/2), fh_y_final_in)\n        fh_in.setInput(0, branch_dot_in)\n        fh_in\[\"firstFrame\"].setValue(frame_val)\n        \n        if i < len(gt_columns):\n            corresponding_gt_fh = gt_columns\[i]\['fh']\n            try:\n                fh_in\[\"firstFrame\"].setExpression(f\"\{corresponding_gt_fh.name()\}.firstFrame\")\n            except Exception as e:\n                print(f\"Could not set expression for \{fh_in.name()\} linking to \{corresponding_gt_fh.name()\}: \{e\}\")\n        else:\n            print(f\"Warning: Could not find corresponding GT FrameHold for IN FrameHold (index \{i\}, frame \{frame_val\})\")\n        \n        in_columns.append(\{'dot': branch_dot_in, 'fh': fh_in, 'frame': frame_val, 'id': i\})\n        nodes_in_for_backdrop.extend(\[branch_dot_in, fh_in])\n\n    # --- AppendClip and new nodes (Dots, Writes, Merge) ---\n    appendclip_gt, appendclip_in = None, None\n    dot_post_ac_gt, dot_post_ac_in = None, None\n    write_gt, write_in = None, None\n    merge_diff = None\n    standard_vertical_spacing = 60\n    standard_horizontal_spacing = 30\n\n    all_fh_nodes_combined = \[col\['fh'] for col in gt_columns] + \[col\['fh'] for col in in_columns]\n    y_for_appendclips = main_dot_y + 280\n    if all_fh_nodes_combined:\n        y_for_appendclips = max(n.ypos() + n.screenHeight() for n in all_fh_nodes_combined) + 50\n\n    if gt_columns:\n        fh_nodes_gt_sorted_for_ac = sorted(\[col\['fh'] for col in gt_columns], key=lambda n: n.xpos())\n        center_x_gt_ac = 0\n        if fh_nodes_gt_sorted_for_ac:\n             center_x_gt_ac = int(round(sum(n.xpos() + n.screenWidth() / 2.0 for n in fh_nodes_gt_sorted_for_ac) / len(fh_nodes_gt_sorted_for_ac)))\n        \n        appendclip_gt = create_node_in_root(\"AppendClip\", name=\"AppendClip_GT_Output\")\n        appendclip_gt.setXYpos(center_x_gt_ac - int(appendclip_gt.screenWidth()/2.0), int(y_for_appendclips))\n        for i_ac, fh_ac in enumerate(fh_nodes_gt_sorted_for_ac):\n            appendclip_gt.setInput(i_ac, fh_ac)\n\n        dot_post_ac_gt = create_node_in_root(\"Dot\", name=\"Dot_PostAC_GT\")\n        dot_post_ac_gt.setXYpos(appendclip_gt.xpos() + appendclip_gt.screenWidth()//2 - dot_post_ac_gt.screenWidth()//2,\n                                appendclip_gt.ypos() + appendclip_gt.screenHeight() + standard_vertical_spacing)\n        dot_post_ac_gt.setInput(0, appendclip_gt)\n\n        write_gt = create_node_in_root(\"Write\", name=\"Write_GT_Output\", file_type=\"exr\", datatype=\"16 bit half\")\n        write_gt.setXYpos(dot_post_ac_gt.xpos() - write_gt.screenWidth() - standard_horizontal_spacing,\n                          dot_post_ac_gt.ypos())\n        write_gt.setInput(0, dot_post_ac_gt)\n        nodes_gt_for_backdrop.extend(\[appendclip_gt, dot_post_ac_gt, write_gt])\n\n\n    if in_columns:\n        fh_nodes_in_sorted_for_ac = sorted(\[col\['fh'] for col in in_columns], key=lambda n: n.xpos())\n        center_x_in_ac = 0\n        if fh_nodes_in_sorted_for_ac:\n            center_x_in_ac = int(round(sum(n.xpos() + n.screenWidth() / 2.0 for n in fh_nodes_in_sorted_for_ac) / len(fh_nodes_in_sorted_for_ac)))\n\n        appendclip_in_y = y_for_appendclips\n        if appendclip_gt: \n             appendclip_in_y = appendclip_gt.ypos() \n        \n        appendclip_in = create_node_in_root(\"AppendClip\", name=\"AppendClip_IN_Output\")\n        appendclip_in.setXYpos(center_x_in_ac - int(appendclip_in.screenWidth()/2.0), int(appendclip_in_y))\n        for i_ac, fh_ac in enumerate(fh_nodes_in_sorted_for_ac):\n            appendclip_in.setInput(i_ac, fh_ac)\n\n        dot_post_ac_in = create_node_in_root(\"Dot\", name=\"Dot_PostAC_IN\")\n        dot_post_ac_in.setXYpos(appendclip_in.xpos() + appendclip_in.screenWidth()//2 - dot_post_ac_in.screenWidth()//2,\n                                appendclip_in.ypos() + appendclip_in.screenHeight() + standard_vertical_spacing)\n        dot_post_ac_in.setInput(0, appendclip_in)\n        if dot_post_ac_gt: # Align Y if GT dot exists\n            dot_post_ac_in.setYpos(dot_post_ac_gt.ypos())\n\n\n        write_in = create_node_in_root(\"Write\", name=\"Write_IN_Output\", file_type=\"exr\", datatype=\"16 bit half\")\n        write_in.setXYpos(dot_post_ac_in.xpos() + dot_post_ac_in.screenWidth() + standard_horizontal_spacing,\n                          dot_post_ac_in.ypos())\n        write_in.setInput(0, dot_post_ac_in)\n        nodes_in_for_backdrop.extend(\[appendclip_in, dot_post_ac_in, write_in])\n\n    if dot_post_ac_gt and dot_post_ac_in:\n        merge_diff = create_node_in_root(\"Merge2\", name=\"Merge_Difference_AC\", operation=\"difference\")\n        merge_x_center = (dot_post_ac_gt.xpos() + dot_post_ac_gt.screenWidth()//2 + \n                          dot_post_ac_in.xpos() + dot_post_ac_in.screenWidth()//2) // 2\n        merge_diff.setXYpos(merge_x_center - merge_diff.screenWidth()//2, dot_post_ac_gt.ypos())\n        merge_diff.setInput(0, dot_post_ac_in) # A input\n        merge_diff.setInput(1, dot_post_ac_gt) # B input\n        # Decide which backdrop it belongs to or if it's neutral. For now, not adding to specific list.\n        # If it needs to be in a backdrop, it would typically be with the \"comparison\" tools like CopyCat later.\n\n\n    # --- Downstream processing (Crop, Shuffle, Remove, etc.) ---\n    y_cursor_start_pipe = y_for_appendclips # Base Y for this section\n    if dot_post_ac_gt and dot_post_ac_in:\n        y_cursor_start_pipe = max(dot_post_ac_gt.ypos() + dot_post_ac_gt.screenHeight(), \n                                  dot_post_ac_in.ypos() + dot_post_ac_in.screenHeight()) + standard_vertical_spacing + 20\n    elif dot_post_ac_gt:\n        y_cursor_start_pipe = dot_post_ac_gt.ypos() + dot_post_ac_gt.screenHeight() + standard_vertical_spacing + 20\n    elif dot_post_ac_in:\n        y_cursor_start_pipe = dot_post_ac_in.ypos() + dot_post_ac_in.screenHeight() + standard_vertical_spacing + 20\n    \n    crop_gt, shuffle_gt, remove_gt, dot_gt_final = None, None, None, None\n    current_y_for_gt_pipe = y_cursor_start_pipe\n    if dot_post_ac_gt: # GT processing pipe starts from dot_post_ac_gt\n        crop_gt = create_node_in_root(\"Crop\", name=\"Crop_GT_Output\")\n        crop_gt.setXYpos(dot_post_ac_gt.xpos() + dot_post_ac_gt.screenWidth()//2 - crop_gt.screenWidth()//2, int(current_y_for_gt_pipe))\n        crop_gt.setInput(0, dot_post_ac_gt) # Connect to the new Dot\n        current_y_for_gt_pipe = crop_gt.ypos() + crop_gt.screenHeight() + standard_vertical_spacing\n        current_gt_pipe_node = crop_gt\n        \n        if mode == \"ROTO\": \n            shuffle_gt = create_node_in_root(\"Shuffle2\", name=\"Shuffle_GT_AlphaToRed\")\n            shuffle_gt.setXYpos(current_gt_pipe_node.xpos() + current_gt_pipe_node.screenWidth()//2 - shuffle_gt.screenWidth()//2, int(current_y_for_gt_pipe))\n            shuffle_gt.setInput(0, current_gt_pipe_node) \n            \n            shuffle_gt\['in1'].setValue('rgba')\n            shuffle_gt\['mappings'].setValue(\[\n                (0, 'rgba.alpha', 'rgba.red'),    \n                (0, 'black', 'rgba.green'),       \n                (0, 'black', 'rgba.blue'),        \n                (0, 'white', 'rgba.alpha')        \n            ])\n            \n            current_gt_pipe_node = shuffle_gt\n            current_y_for_gt_pipe = shuffle_gt.ypos() + shuffle_gt.screenHeight() + standard_vertical_spacing\n        \n        remove_gt = create_node_in_root(\"Remove\", name=\"Remove_GT_Channels\")\n        remove_gt.setXYpos(current_gt_pipe_node.xpos() + current_gt_pipe_node.screenWidth()//2 - remove_gt.screenWidth()//2, int(current_y_for_gt_pipe))\n        remove_gt.setInput(0, current_gt_pipe_node)\n        remove_gt\[\"operation\"].setValue(\"keep\")\n        if mode == \"ROTO\":\n            remove_gt\[\"channels\"].setValue(\"r\") \n            remove_gt\[\"channels2\"].setValue(\"r\")\n        else:\n            remove_gt\[\"channels\"].setValue(\"rgba\") \n            remove_gt\[\"channels2\"].setValue(\"rgba\")\n\n        current_y_for_gt_pipe = remove_gt.ypos() + remove_gt.screenHeight() + standard_vertical_spacing\n\n        dot_gt_final = create_node_in_root(\"Dot\", name=\"Dot_GT_Final\")\n        dot_gt_final.setXYpos(int(round(remove_gt.xpos() + remove_gt.screenWidth()/2.0 - dot_gt_final.screenWidth()/2.0)) , int(current_y_for_gt_pipe))\n        dot_gt_final.setInput(0, remove_gt)\n        nodes_gt_for_backdrop.extend(\[crop_gt, shuffle_gt, remove_gt, dot_gt_final])\n\n\n    current_y_for_in_pipe = y_cursor_start_pipe\n    crop_in, remove_in, dot_in_final = None, None, None\n    if dot_post_ac_in: # IN processing pipe starts from dot_post_ac_in\n        crop_in_y_pos = crop_gt.ypos() if crop_gt else int(current_y_for_in_pipe)\n        crop_in = create_node_in_root(\"Crop\", name=\"Crop_IN_Output\")\n        crop_in.setXYpos(dot_post_ac_in.xpos() + dot_post_ac_in.screenWidth()//2 - crop_in.screenWidth()//2, crop_in_y_pos)\n        crop_in.setInput(0, dot_post_ac_in) # Connect to the new Dot\n        current_y_for_in_pipe = crop_in.ypos() + crop_in.screenHeight() + standard_vertical_spacing\n        \n        remove_in_y_pos = remove_gt.ypos() if remove_gt else int(current_y_for_in_pipe)\n        remove_in = create_node_in_root(\"Remove\", name=\"Remove_IN_Channels\")\n        remove_in.setXYpos(crop_in.xpos() + crop_in.screenWidth()//2 - remove_in.screenWidth()//2, remove_in_y_pos)\n        remove_in.setInput(0, crop_in)\n        remove_in\[\"operation\"].setValue(\"keep\")\n        remove_in\[\"channels\"].setValue(\"rgba\")\n        remove_in\[\"channels2\"].setValue(\"rgba\")\n        current_y_for_in_pipe = remove_in.ypos() + remove_in.screenHeight() + standard_vertical_spacing\n        \n        dot_in_y_pos = dot_gt_final.ypos() if dot_gt_final else int(current_y_for_in_pipe)\n        dot_in_final = create_node_in_root(\"Dot\", name=\"Dot_IN_Final\")\n        dot_in_final.setXYpos(int(round(remove_in.xpos() + remove_in.screenWidth()/2.0 - dot_in_final.screenWidth()/2.0)), dot_in_y_pos)\n        dot_in_final.setInput(0, remove_in)\n        nodes_in_for_backdrop.extend(\[crop_in, remove_in, dot_in_final])\n\n\n    copycat = None\n    if dot_gt_final and dot_in_final:\n        copycat_y_base = max(dot_gt_final.ypos() + dot_gt_final.screenHeight(), dot_in_final.ypos() + dot_in_final.screenHeight())\n        if merge_diff: # Position CopyCat below Merge if it exists\n            copycat_y_base = max(copycat_y_base, merge_diff.ypos() + merge_diff.screenHeight())\n\n        copycat = create_node_in_root(\"CopyCat\", name=\"Compare_GT_IN_CopyCat\")\n        copycat_x_center = (dot_gt_final.xpos() + dot_gt_final.screenWidth()/2 + dot_in_final.xpos() + dot_in_final.screenWidth()/2) / 2 \n        copycat_y = copycat_y_base + standard_vertical_spacing + 20\n        copycat.setXYpos(int(round(copycat_x_center - copycat.screenWidth()/2)), int(copycat_y))\n        copycat.setInput(0, dot_in_final) \n        copycat.setInput(1, dot_gt_final) \n        # Add CopyCat and MergeDiff to a general backdrop or GT backdrop if appropriate\n        if merge_diff: nodes_gt_for_backdrop.append(merge_diff) # Or a new \"comparison\" backdrop\n        nodes_gt_for_backdrop.append(copycat)\n\n\n    padding = 50 \n    title_padding = 30 \n\n    # Filter out None values more robustly before min/max\n    gt_backdrop_nodes_collected = \[n for n in \[framerange_node, main_dot] if n is not None]\n    for col in gt_columns: gt_backdrop_nodes_collected.extend(filter(None, \[col\['dot'], col\['roto'], col\['fh']]))\n    gt_backdrop_nodes_collected.extend(filter(None, \[appendclip_gt, dot_post_ac_gt, write_gt, crop_gt, shuffle_gt, remove_gt, dot_gt_final, merge_diff, copycat]))\n    gt_backdrop_nodes_collected = list(set(gt_backdrop_nodes_collected))\n\n\n    backdrop_gt_instance = None\n    if gt_backdrop_nodes_collected:\n        min_x = min(n.xpos() for n in gt_backdrop_nodes_collected)\n        max_x = max(n.xpos() + n.screenWidth() for n in gt_backdrop_nodes_collected)\n        min_y = min(n.ypos() for n in gt_backdrop_nodes_collected)\n        max_y = max(n.ypos() + n.screenHeight() for n in gt_backdrop_nodes_collected)\n        \n        backdrop_gt_instance = create_node_in_root(\"BackdropNode\",\n            label=\"Groundtruth Generation & Comparison\", note_font_size=32, tile_color=1436500735, \n            xpos=int(min_x - padding), \n            ypos=int(min_y - padding - title_padding),\n            bdwidth=int(round((max_x - min_x) + 2 * padding)),\n            bdheight=int(round((max_y - min_y) + 2 * padding + title_padding)))\n\n    in_nodes_for_bd_calc = \[]\n    for col in in_columns: in_nodes_for_bd_calc.extend(filter(None, \[col\['dot'], col\['fh']]))\n    in_nodes_for_bd_calc.extend(filter(None, \[appendclip_in, dot_post_ac_in, write_in, crop_in, remove_in, dot_in_final]))\n    in_nodes_for_bd_calc = list(set(in_nodes_for_bd_calc))\n\n\n    if in_nodes_for_bd_calc:\n        min_x_in_bd = min(n.xpos() for n in in_nodes_for_bd_calc)\n        max_x_in_bd = max(n.xpos() + n.screenWidth() for n in in_nodes_for_bd_calc)\n        \n        bd_ypos_in = int(min(n.ypos() for n in in_nodes_for_bd_calc) - padding - title_padding)\n        bd_height_in = int(round(max(n.ypos() + n.screenHeight() for n in in_nodes_for_bd_calc) - min(n.ypos() for n in in_nodes_for_bd_calc) + 2 * padding + title_padding))\n\n        if backdrop_gt_instance:\n            bd_ypos_in = backdrop_gt_instance.ypos()\n            bd_height_in = backdrop_gt_instance.knob(\"bdheight\").value()\n        \n        create_node_in_root(\"BackdropNode\",\n            label=\"Input References\", note_font_size=32, tile_color=1144127743, \n            xpos=int(min_x_in_bd - padding), \n            ypos=bd_ypos_in,\n            bdwidth=int(round((max_x_in_bd - min_x_in_bd) + 2 * padding)),\n            bdheight=bd_height_in)\n\n    def framehold_sync_callback():\n        node = nuke.thisNode() \n        knob = nuke.thisKnob() \n\n        if knob.name() != \"firstFrame\": \n            return\n\n        changed_node_name = node.name()\n        match = re.match(r\"^(GT|IN)(\\d+)(_?\\d*)\$\", changed_node_name)\n        if not match: \n            return \n\n        new_frame_val = int(knob.value())\n        self_prefix = match.group(1) \n        original_frame_in_name_str = match.group(2) \n        current_suffix = match.group(3) \n        partner_prefix = \"IN\" if self_prefix == \"GT\" else \"GT\"\n        \n        partner_name_candidate = f\"\{partner_prefix\}\{original_frame_in_name_str\}\{current_suffix\}\"\n        partner_node = nuke.toNode(partner_name_candidate)\n\n        if partner_node and partner_node.Class() == \"FrameHold\":\n            if partner_node\[\"firstFrame\"].value() != new_frame_val:\n                is_in_node_with_expr = (partner_prefix == \"IN\" and partner_node\[\"firstFrame\"].hasExpression())\n                if not (is_in_node_with_expr and self_prefix == \"GT\"):\n                     partner_node\[\"firstFrame\"].setValue(new_frame_val)\n            \n            new_frame_val_str_cb = str(new_frame_val)\n            final_new_partner_name = f\"\{partner_prefix\}\{new_frame_val_str_cb\}\{current_suffix\}\"\n            if partner_node.name() != final_new_partner_name:\n                if not nuke.toNode(final_new_partner_name): \n                    try:\n                        partner_node\['name'].setValue(final_new_partner_name)\n                    except RuntimeError as e:\n                        print(f\"Callback: Error renaming partner node to \{final_new_partner_name\}: \{e\}\")\n\n        new_frame_val_str_cb_self = str(new_frame_val)\n        final_new_self_name = f\"\{self_prefix\}\{new_frame_val_str_cb_self\}\{current_suffix\}\"\n        if node.name() != final_new_self_name:\n            if not nuke.toNode(final_new_self_name): \n                try:\n                    node\['name'].setValue(final_new_self_name)\n                except RuntimeError as e:\n                    print(f\"Callback: Error renaming self node to \{final_new_self_name\}: \{e\}\")\n\n    if not hasattr(create_ground_truth, \"framehold_sync_callback_registered\"): \n        nuke.addKnobChanged(framehold_sync_callback, nodeClass=\"FrameHold\")\n        create_ground_truth.framehold_sync_callback_registered = True\n\n    for node_sel in old_selection:\n        if node_sel and node_sel.name() in nuke.allNodes(group=nuke.root()): \n            node_sel\['selected'].setValue(True)\n\n# Example call:\ncreate_ground_truth()" +STARTLINE}
}
