addUserKnob {20 User}
addUserKnob {22 run_button l "Run Copcat" T "import nuke\n\ndef create_ground_truth():\n    # Get the root node graph context\n    root = nuke.root()\n\n    read_node = None\n\n    # Try to get current node context if possible\n    try:\n        current_node = nuke.thisNode()\n    except NameError:\n        current_node = None\n\n    group_node = None\n    # Check if inside a Group node\n    if current_node is not None:\n        if current_node.Class() == \"Group\":\n            group_node = current_node\n        else:\n            try:\n                parent = current_node.parent()\n                if parent and parent.Class() == \"Group\":\n                    group_node = parent\n            except Exception:\n                pass\n\n    # Check if the current node is a gizmo (NoOp) and if the first input is connected\n    if current_node is not None and current_node.Class() == \"NoOp\":\n        input_node = current_node.input(0)\n        if input_node and input_node.Class() == \"Read\":\n            read_node = input_node\n\n    # First try to get the Read node connected as first input to the group node (if any)\n    if group_node is not None:\n        input_node = group_node.input(0)\n        if input_node and input_node.Class() == \"Read\":\n            read_node = input_node\n\n    # If no Read node found via group inputs or gizmo input, fallback to selected Read node in root context\n    if read_node is None:\n        selected_in_root = \[node for node in nuke.selectedNodes() if node.Class() == \"Read\"]\n        if selected_in_root:\n            read_node = selected_in_root\[0]\n\n    # If still no Read node found, show message and abort\n    if read_node is None or read_node.Class() != \"Read\":\n        nuke.message(\"Please connect a Read node to the first input of the gizmo or select a Read node.\")\n        return\n\n    # Save user selection and current script node so we can restore later\n    old_selection = nuke.selectedNodes()\n    current_node_backup = current_node\n\n    # Deselect all nodes\n    for node in old_selection:\n        node\['selected'].setValue(False)\n\n    # Select the read node to position relative nodes later\n    read_node\['selected'].setValue(True)\n\n    read_x = read_node.xpos()\n    read_width = read_node.screenWidth()\n    read_y = read_node.ypos()\n    read_height = read_node.screenHeight()\n\n    # Helper function to create node in root context and position it\n    def create_node_in_root(node_class, **kwargs):\n        with nuke.root():\n            node = nuke.createNode(node_class, inpanel=False)\n        for k,v in kwargs.items():\n            if k == 'xpos':\n                node.setXpos(v)\n            elif k == 'ypos':\n                node.setYpos(v)\n            elif k == 'name' and v:\n                node\['name'].setValue(v)\n            else:\n                try:\n                    node\[k].setValue(v)\n                except Exception:\n                    pass\n        return node\n\n    # Create FrameRange node below Read node\n    framerange_node = create_node_in_root(\"FrameRange\")\n    framerange_node.setXYpos(read_x, read_y + read_height + 50)\n    framerange_node\[\"first_frame\"].setValue(1)\n    framerange_node\[\"last_frame\"].setValue(1)\n    framerange_node.setInput(0, read_node)\n\n    # Main Dot below FrameRange\n    framerange_y = framerange_node.ypos()\n    main_dot_x = int(round(read_x + read_width / 2.25))\n    main_dot_y = int(round(framerange_y + 50))\n    main_dot = create_node_in_root(\"Dot\", name=\"Groundtruth_MainDot\")\n    main_dot.setXYpos(main_dot_x, main_dot_y)\n    main_dot.setInput(0, framerange_node)\n\n    # Create custom panel for number of frames and option selection as dropdown\n    panel = nuke.Panel(\"Ground Truth Setup\")\n    panel.addSingleLineInput(\"Number of ground truth frames:\", \"1\")\n    panel.addEnumerationPulldown(\"Mode:\", \"Retouch ROTO\")\n\n    if not panel.show():\n        # Restore selection and exit\n        for node in old_selection:\n            node\['selected'].setValue(True)\n        return\n\n    num_frames_str = panel.value(\"Number of ground truth frames:\")\n    mode = panel.value(\"Mode:\")\n\n    # Validate number of frames input\n    if not num_frames_str.isdigit() or int(num_frames_str) < 1:\n        nuke.message(\"Invalid number of frames.\")\n        for node in old_selection:\n            node\['selected'].setValue(True)\n        return\n    num_frames = int(num_frames_str)\n\n    # Frame range calculation\n    first_frame = int(nuke.root()\[\"first_frame\"].value())\n    last_frame = int(nuke.root()\[\"last_frame\"].value())\n    total_frames = last_frame - first_frame + 1\n\n    if num_frames == 1:\n        frames = \[first_frame + total_frames // 2]\n    else:\n        step = max(total_frames // (num_frames - 1), 1)\n        frames = \[first_frame + i * step for i in range(num_frames)]\n        if frames\[-1] != last_frame:\n            frames\[-1] = last_frame\n\n    # --- Left side Groundtruth branch (Right to Left) ---\n    nodes_gt = \[]\n    fh_nodes_gt = \[]\n    roto_nodes_gt = \[]\n    dot_nodes_gt = \[main_dot]\n\n    start_x_gt = main_dot_x - 350\n    spacing_gt = 350\n\n    previous_dot_gt = main_dot\n\n    for i, frame in enumerate(frames):\n        dot_x = start_x_gt - i * spacing_gt\n        dot_y = main_dot_y\n\n        if i == 0:\n            connect_node = main_dot\n        else:\n            dot = create_node_in_root(\"Dot\", name=f\"Dot_GroundTruth_\{frame\}\")\n            dot.setXYpos(dot_x, dot_y)\n            dot.setInput(0, previous_dot_gt)\n            previous_dot_gt = dot\n            dot_nodes_gt.append(dot)\n\n        roto_x = dot_x\n        roto_y = dot_y + 80\n        fh_y = roto_y + 120\n\n        node_name = f\"Roto_GroundTruth\{i + 1\}\"\n        if mode == \"Retouch\":\n            roto = create_node_in_root(\"RotoPaint\", name=node_name)\n            roto.setXYpos(roto_x - 35, roto_y - 35)\n        else:\n            roto = create_node_in_root(\"Roto\", name=node_name)\n            roto.setXYpos(roto_x - 35, roto_y - 35)\n            if \"replace\" in roto.knobs():\n                roto\[\"replace\"].setValue(True)\n\n        roto_nodes_gt.append(roto)\n\n        fh = create_node_in_root(\"FrameHold\", name=f\"GT\{frame\}\")\n        fh.setXYpos(roto_x - 35, fh_y - 35)\n        fh.setInput(0, roto)\n        fh\[\"first_frame\"].setValue(frame)\n        fh_nodes_gt.append(fh)\n        nodes_gt.extend(\[roto, fh])\n\n    if fh_nodes_gt and roto_nodes_gt:\n        all_nodes = fh_nodes_gt + roto_nodes_gt\n        min_x = min(n.xpos() for n in all_nodes)\n        max_x = max(n.xpos() for n in all_nodes)\n        center_x = (min_x + max_x) / 2\n        for n in all_nodes:\n            old_x = n.xpos()\n            new_x = int(center_x + (center_x - old_x))\n            n.setXpos(new_x)\n\n    roto_nodes_sorted = sorted(roto_nodes_gt, key=lambda n: n.xpos())\n    dot_nodes_sorted = sorted(dot_nodes_gt, key=lambda n: n.xpos())\n\n    for roto, dot in zip(roto_nodes_sorted, dot_nodes_sorted):\n        roto.setInput(0, dot)\n\n    fh_first_gt = fh_nodes_gt\[0]\n    fh_last_gt = fh_nodes_gt\[-1]\n    center_x_gt = int((fh_first_gt.xpos() + fh_last_gt.xpos()) / 2)\n    below_y_gt = max(n.ypos() for n in fh_nodes_gt) + 150\n\n    appendclip_gt = create_node_in_root(\"AppendClip\")\n    appendclip_gt.setXYpos(center_x_gt, below_y_gt)\n    for i, fh in enumerate(fh_nodes_gt):\n        appendclip_gt.setInput(i, fh)\n\n    nodes_in = \[]\n    fh_nodes_in = \[]\n\n    start_x_in = main_dot_x + 350\n    spacing_in = 350\n\n    previous_dot_in = main_dot\n\n    for i, frame in enumerate(frames):\n        dot_x_in = start_x_in + i * spacing_in\n        dot_y_in = main_dot_y\n\n        dot_in = create_node_in_root(\"Dot\", name=f\"Dot_Input_\{frame\}\")\n        dot_in.setXYpos(dot_x_in, dot_y_in)\n        dot_in.setInput(0, previous_dot_in)\n        previous_dot_in = dot_in\n        nodes_in.append(dot_in)\n\n        fh_y_in = dot_y_in + 120\n\n        fh_in = create_node_in_root(\"FrameHold\", name=f\"IN\{frame\}\")\n        fh_in.setXYpos(dot_x_in - 35, fh_y_in - 35)\n        fh_in.setInput(0, dot_in)\n        fh_in\[\"first_frame\"].setValue(frame)\n\n        # Sync FrameHold with groundtruth\n        fh_in\[\"first_frame\"].setExpression(f\"\{fh_nodes_gt\[i].name()\}.first_frame\")\n\n        fh_nodes_in.append(fh_in)\n        nodes_in.append(fh_in)\n\n    appendclip_in = None\n    if fh_nodes_in:\n        fh_first_in = fh_nodes_in\[0]\n        fh_last_in = fh_nodes_in\[-1]\n        center_x_in = int((fh_first_in.xpos() + fh_last_in.xpos()) / 2)\n        below_y_in = max(n.ypos() for n in fh_nodes_in) + 150\n\n        appendclip_in = create_node_in_root(\"AppendClip\")\n        appendclip_in.setXYpos(center_x_in, below_y_in)\n        for i, fh in enumerate(fh_nodes_in):\n            appendclip_in.setInput(i, fh)\n\n    padding = 40\n    crop_y = int(\n        (appendclip_gt.ypos() + (appendclip_in.ypos() if appendclip_in else appendclip_gt.ypos())) / 2 + 100\n    )\n\n    crop_gt = create_node_in_root(\"Crop\")\n    crop_gt.setXYpos(appendclip_gt.xpos(), crop_y)\n    crop_gt.setInput(0, appendclip_gt)\n\n    shuffle_gt = None\n    if mode == \"ROTO\":\n        shuffle_gt = create_node_in_root(\"Shuffle2\")\n        shuffle_gt.setXYpos(crop_gt.xpos(), crop_gt.ypos() + 100)\n        shuffle_gt.setInput(0, crop_gt)\n\n        shuffle_gt\[\"in1\"].setValue(\"rgba\")\n\n        shuffle_gt\[\"mappings\"].setValue(\n            \[\n                (0, \"black\", \"rgba.red\"),\n                (0, \"black\", \"rgba.green\"),\n                (0, \"black\", \"rgba.blue\"),\n                (0, \"black\", \"rgba.alpha\"),\n            ]\n        )\n        shuffle_gt\[\"mappings\"].setValue(\n            \[\n                (0, \"rgba.alpha\", \"rgba.red\"),\n                (0, \"black\", \"rgba.green\"),\n                (0, \"black\", \"rgba.blue\"),\n                (0, \"black\", \"rgba.alpha\"),\n            ]\n        )\n\n    crop_in = None\n    if appendclip_in:\n        crop_in = create_node_in_root(\"Crop\")\n        crop_in.setXYpos(appendclip_in.xpos(), crop_y)\n        crop_in.setInput(0, appendclip_in)\n\n    remove_y = shuffle_gt.ypos() + 100 if shuffle_gt else crop_gt.ypos() + 100\n\n    remove_gt = create_node_in_root(\"Remove\")\n    remove_gt.setXYpos(crop_gt.xpos(), remove_y)\n    if shuffle_gt:\n        remove_gt.setInput(0, shuffle_gt)\n    else:\n        remove_gt.setInput(0, crop_gt)\n\n    if mode == \"ROTO\" and shuffle_gt:\n        remove_gt\[\"operation\"].setValue(\"keep\")\n        remove_gt\[\"channels\"].setValue(\"r\")\n    else:\n        remove_gt\[\"operation\"].setValue(\"keep\")\n        remove_gt\[\"channels\"].setValue(\"rgba\")\n\n    remove_in = None\n    if crop_in:\n        remove_in = create_node_in_root(\"Remove\")\n        remove_in.setXYpos(crop_in.xpos(), remove_y)\n        remove_in.setInput(0, crop_in)\n        remove_in\[\"operation\"].setValue(\"keep\")\n        remove_in\[\"channels\"].setValue(\"rgba\")\n\n    dot_gt = create_node_in_root(\"Dot\")\n    dot_gt.setXYpos(remove_gt.xpos() + 35, remove_gt.ypos() + 80)\n    dot_gt.setInput(0, remove_gt)\n\n    dot_in = None\n    if remove_in:\n        dot_in = create_node_in_root(\"Dot\")\n        dot_in.setXYpos(remove_in.xpos() + 35, remove_in.ypos() + 80)\n        dot_in.setInput(0, remove_in)\n\n    copycat = None\n    if dot_gt and dot_in:\n        copycat = create_node_in_root(\"CopyCat\")\n        copycat_x = (dot_gt.xpos() + dot_in.xpos()) // 2\n        copycat_y = dot_gt.ypos() + 100\n        copycat.setXYpos(copycat_x, copycat_y)\n        copycat.setInput(0, dot_in)\n        copycat.setInput(1, dot_gt)\n\n    # Create backdrop for groundtruth nodes\n    all_nodes_gt = nodes_gt + fh_nodes_gt + roto_nodes_gt + \[\n        main_dot,\n        framerange_node,\n        appendclip_gt,\n        crop_gt,\n        remove_gt,\n        dot_gt,\n    ]\n    if shuffle_gt:\n        all_nodes_gt.append(shuffle_gt)\n\n    min_x_gt = min(n.xpos() for n in all_nodes_gt)\n    max_x_gt = max(n.xpos() + n.screenWidth() for n in all_nodes_gt)\n    min_y_gt = min(n.ypos() for n in all_nodes_gt)\n    max_y_gt = max(n.ypos() + n.screenHeight() for n in all_nodes_gt)\n\n    backdrop_gt = create_node_in_root(\"BackdropNode\")\n    backdrop_gt\[\"label\"].setValue(\"Groundtruth\")\n    backdrop_gt\[\"note_font_size\"].setValue(24)\n    backdrop_gt\[\"tile_color\"].setValue(4292899327)\n    backdrop_gt\[\"z_order\"].setValue(-10)\n    backdrop_gt.setXpos(int(min_x_gt - padding))\n    backdrop_gt.setYpos(int(min_y_gt - padding))\n    backdrop_gt\[\"bdwidth\"].setValue(int((max_x_gt - min_x_gt) + 2 * padding))\n    backdrop_gt\[\"bdheight\"].setValue(int((max_y_gt - min_y_gt) + 2 * padding))\n\n    # Create backdrop for input nodes\n    all_nodes_in = nodes_in + fh_nodes_in\n    if appendclip_in:\n        all_nodes_in.append(appendclip_in)\n    if crop_in:\n        all_nodes_in.append(crop_in)\n    if remove_in:\n        all_nodes_in.append(remove_in)\n    if dot_in:\n        all_nodes_in.append(dot_in)\n\n    min_x_in = min(n.xpos() for n in all_nodes_in)\n    max_x_in = max(n.xpos() + n.screenWidth() for n in all_nodes_in)\n    min_y_in = min(n.ypos() for n in all_nodes_in)\n    max_y_in = max(n.ypos() + n.screenHeight() for n in all_nodes_in)\n\n    backdrop_in = create_node_in_root(\"BackdropNode\")\n    backdrop_in\[\"label\"].setValue(\"input nodes\")\n    backdrop_in\[\"note_font_size\"].setValue(24)\n    backdrop_in\[\"tile_color\"].setValue(4289379276)\n    backdrop_in\[\"z_order\"].setValue(-10)\n    backdrop_in.setXpos(int(min_x_in - padding))\n    backdrop_in.setYpos(backdrop_gt.ypos())\n    backdrop_in\[\"bdwidth\"].setValue(backdrop_gt\[\"bdwidth\"].value())\n    backdrop_in\[\"bdheight\"].setValue(backdrop_gt\[\"bdheight\"].value())\n\n    # Align the y positions of paired FrameHold nodes\n    if fh_nodes_gt and fh_nodes_in:\n        avg_fh_gt_y = sum(fh.ypos() for fh in fh_nodes_gt) / len(fh_nodes_gt)\n        for fh_in in fh_nodes_in:\n            fh_in.setYpos(int(avg_fh_gt_y))\n\n    if appendclip_gt and appendclip_in:\n        appendclip_in.setYpos(appendclip_gt.ypos())\n\n    # FrameHold sync callback\n    def framehold_sync_callback():\n        node = nuke.thisNode()\n        knob = nuke.thisKnob()\n        if knob.name() != \"first_frame\":\n            return\n\n        name = node.name()\n        if name.startswith(\"GT\"):\n            frame = name\[2:]\n            pair_name = f\"IN\{frame\}\"\n        elif name.startswith(\"IN\"):\n            frame = name\[2:]\n            pair_name = f\"GT\{frame\}\"\n        else:\n            return\n\n        for n in nuke.allNodes(\"FrameHold\"):\n            if n.name() == pair_name:\n                if n\[\"first_frame\"].value() != knob.value():\n                    n\[\"first_frame\"].setValue(knob.value())\n                if pair_name.startswith(\"IN\"):\n                    n\[\"name\"].setValue(f\"IN\{n\['first_frame'].value()\}\")\n                break\n\n    if not hasattr(create_ground_truth, \"callback_registered\"):\n        nuke.addKnobChanged(framehold_sync_callback, nodeClass=\"FrameHold\")\n        create_ground_truth.callback_registered = True\n\n    # Restore previous node selection\n    for node in old_selection:\n        node\['selected'].setValue(True)\n\ncreate_ground_truth()" +STARTLINE}
}
