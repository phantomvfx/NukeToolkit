 addUserKnob {22 b4_u l "^" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off4')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
