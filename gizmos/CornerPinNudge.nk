 addUserKnob {26 hdr_all l "ALL corners (move whole plane)" T " "}
 addUserKnob {22 b_all_l l "<" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off_all')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {22 b_all_r l ">" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off_all')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b_all_u l "^" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off_all')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b_all_d l "v" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off_all')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {22 reset_offsets l "Reset all offsets" T "n = nuke.thisNode()\nfor p in ('to', 'from', 'tok'):\n    for s in ('1', '2', '3', '4', '_all'):\n        k = n.knob(p + '_off' + s)\n        k.clearAnimated()\n        k.setValue(0, 0)\n        k.setValue(0, 1)"}
 addUserKnob {22 reset_keyed l "Reset keyed only" -STARTLINE T "n = nuke.thisNode()\nfor p in ('tok',):\n    for s in ('1', '2', '3', '4', '_all'):\n        k = n.knob(p + '_off' + s)\n        k.clearAnimated()\n        k.setValue(0, 0)\n        k.setValue(0, 1)"}
 addUserKnob {26 divo l "" +STARTLINE T "<b>Offsets (static)</b>"}
 addUserKnob {12 to_off1 l "To Corner 1"}
 addUserKnob {12 to_off2 l "To Corner 2"}
 addUserKnob {12 to_off3 l "To Corner 3"}
 addUserKnob {12 to_off4 l "To Corner 4"}
 addUserKnob {12 to_off_all l "To ALL"}
 addUserKnob {12 from_off1 l "From Corner 1"}
 addUserKnob {12 from_off2 l "From Corner 2"}
 addUserKnob {12 from_off3 l "From Corner 3"}
 addUserKnob {12 from_off4 l "From Corner 4"}
 addUserKnob {12 from_off_all l "From ALL"}
 addUserKnob {12 tok_off1 l "To keyed Corner 1"}
 addUserKnob {12 tok_off2 l "To keyed Corner 2"}
 addUserKnob {12 tok_off3 l "To keyed Corner 3"}
 addUserKnob {12 tok_off4 l "To keyed Corner 4"}
 addUserKnob {12 tok_off_all l "To keyed ALL"}
 addUserKnob {26 dive l "" +STARTLINE T "<b>Edges</b>"}
 addUserKnob {6 bleed l "Bleed edges (black outside off)" +STARTLINE}
 bleed true
 addUserKnob {6 limit l "Limit bleed to format + overscan" +STARTLINE}
 limit true
 addUserKnob {7 overscan l "Overscan (px)" R 0 500}
 overscan 100
}
 Input {
  inputs 0
  name Input1
  xpos 0
  ypos -200
 }
 CornerPin2D {
  inputs 1
  to1 {{Tracked.to1.x+parent.use_offsets*(parent.to_off1.x+parent.to_off_all.x+parent.tok_off1.x+parent.tok_off_all.x)} {Tracked.to1.y+parent.use_offsets*(parent.to_off1.y+parent.to_off_all.y+parent.tok_off1.y+parent.tok_off_all.y)}}
  to2 {{Tracked.to2.x+parent.use_offsets*(parent.to_off2.x+parent.to_off_all.x+parent.tok_off2.x+parent.tok_off_all.x)} {Tracked.to2.y+parent.use_offsets*(parent.to_off2.y+parent.to_off_all.y+parent.tok_off2.y+parent.tok_off_all.y)}}
  to3 {{Tracked.to3.x+parent.use_offsets*(parent.to_off3.x+parent.to_off_all.x+parent.tok_off3.x+parent.tok_off_all.x)} {Tracked.to3.y+parent.use_offsets*(parent.to_off3.y+parent.to_off_all.y+parent.tok_off3.y+parent.tok_off_all.y)}}
  to4 {{Tracked.to4.x+parent.use_offsets*(parent.to_off4.x+parent.to_off_all.x+parent.tok_off4.x+parent.tok_off_all.x)} {Tracked.to4.y+parent.use_offsets*(parent.to_off4.y+parent.to_off_all.y+parent.tok_off4.y+parent.tok_off_all.y)}}
  invert false
  black_outside {{1-parent.bleed}}
  motionblur 1
  shutteroffset centred
  from1 {{Tracked.from1.x+parent.use_offsets*(parent.from_off1.x+parent.from_off_all.x)} {Tracked.from1.y+parent.use_offsets*(parent.from_off1.y+parent.from_off_all.y)}}
  from2 {{Tracked.from2.x+parent.use_offsets*(parent.from_off2.x+parent.from_off_all.x)} {Tracked.from2.y+parent.use_offsets*(parent.from_off2.y+parent.from_off_all.y)}}
  from3 {{Tracked.from3.x+parent.use_offsets*(parent.from_off3.x+parent.from_off_all.x)} {Tracked.from3.y+parent.use_offsets*(parent.from_off3.y+parent.from_off_all.y)}}
  from4 {{Tracked.from4.x+parent.use_offsets*(parent.from_off4.x+parent.from_off_all.x)} {Tracked.from4.y+parent.use_offsets*(parent.from_off4.y+parent.from_off_all.y)}}
  name Pin
  xpos 0
  ypos -100
 }
 Crop {
  box {{-parent.overscan} {-parent.overscan} {root.format.w+parent.overscan} {root.format.h+parent.overscan}}
  reformat false
  disable {{!(parent.bleed&&parent.limit)}}
  name Crop_bleed
  xpos 0
  ypos -20
 }
 Output {
  name Output1
  xpos 0
  ypos 60
 }
 CornerPin2D {
