# CornerPinNudge - tracked CornerPin2D with static position offsets (Nuke 16 / written for 16.0 v6; NOT yet tested in Nuke)
#
# Input  : 0 = the graphic to pin (here a 6000x4000 plate: from1..4 = 0,0 / 6000,0 / 6000,4000 / 0,4000)
# Output : the pinned graphic (CornerPin2D -> Crop)
#
# Inside the Group:
#   Tracked = your original tracked CornerPin2D, UNTOUCHED (all to/from keyframes, Reference Frame tab).
#             It is not connected to the image. Re-paste/replace tracking data in it any time.
#   Pin     = the CornerPin2D that actually warps the image. Every corner is an expression:
#             Tracked.<corner> + use_offsets * (<static offset> + <ALL offset> [+ <keyed offset> for To])
#   Crop    = limits the edge bleed to the root format + "Overscan" px (see below).
#
# "Nudge" tab:
#   Move To / From switch picks which corner set the arrow buttons move.
#   Step (px) sets the nudge size; "x10" multiplies it by 10.
#   <  >  ^  v  = left / right / up / down (Nuke y is up). One row per corner, plus an ALL row.
#   "To" / "From" offsets are STATIC (same on every frame) - a permanent reposition on top of the track.
#   "To (keyed)" offsets are ANIMATED: each button press sets a keyframe at the CURRENT FRAME (x and y of that
#   corner), and Nuke interpolates between keys - the AdjustTrack equivalent for drift. Key the worst frames
#   (e.g. every 8-15 frames) rather than every frame; edit/delete keys in the Curve Editor. "Reset keyed only"
#   clears just the keyed offsets.
#   Offset knobs are shown (and editable by typing) under "Offsets". Reset zeroes all of them.
#   "Use offsets" off = bypass every offset, i.e. the pure tracked result (for A/B).
#   "To" offsets move where the corner lands on screen; "From" offsets move which part of the graphic
#   maps to that corner (so moving a From corner right slides the picture the other way).
#
# Edges: "Bleed edges" = Pin's black outside OFF (edge pixels repeat outward). The bleed repeats the OUTERMOST
#   pixel of the input, so the graphic must have colour right up to its border. "Limit bleed" crops the result
#   to root.format expanded by "Overscan" px so the bbox does not grow without bound - note it uses the
#   project (root) format, not the format of the graphic.
#
# Corner numbering follows the from points: 1 = bottom-left, 2 = bottom-right, 3 = top-right, 4 = top-left.
#
# Use: import with nuke.nodePaste(<this file>) or File > Import Script / drag into the DAG. It will not appear
# in the node toolbar (it is a .nk, not a .gizmo). Select the graphic's node first to auto-connect input 0.
set cut_paste_input [stack 0]
version 16.0 v6
push $cut_paste_input
Group {
 name CornerPinNudge
 selected true
 addUserKnob {20 Nudge l Nudge}
 addUserKnob {4 target l Move M {To From "To (keyed)"}}
 addUserKnob {7 step l "Step (px)" R 0.01 20}
 step 1
 addUserKnob {6 coarse l x10 -STARTLINE}
 addUserKnob {6 use_offsets l "Use offsets" -STARTLINE}
 use_offsets true
 addUserKnob {26 hdr1 l "Corner 1 (bottom-left)" T " "}
 addUserKnob {22 b1_l l "<" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off1')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {22 b1_r l ">" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off1')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b1_u l "^" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off1')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b1_d l "v" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off1')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {26 hdr2 l "Corner 2 (bottom-right)" T " "}
 addUserKnob {22 b2_l l "<" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off2')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {22 b2_r l ">" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off2')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b2_u l "^" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off2')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b2_d l "v" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off2')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {26 hdr3 l "Corner 3 (top-right)" T " "}
 addUserKnob {22 b3_l l "<" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off3')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {22 b3_r l ">" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off3')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b3_u l "^" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off3')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) + d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) + d, i)"}
 addUserKnob {22 b3_d l "v" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off3')\ni = 1\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
 addUserKnob {26 hdr4 l "Corner 4 (top-left)" T " "}
 addUserKnob {22 b4_l l "<" -STARTLINE T "n = nuke.thisNode()\nd = n.knob('step').value() * (10 if n.knob('coarse').value() else 1)\nt = n.knob('target').value()\np = 'tok' if 'keyed' in t else t.lower()\nk = n.knob(p + '_off4')\ni = 0\nif p == 'tok':\n    f = nuke.frame()\n    if not k.isAnimated():\n        k.setAnimated()\n    o = 1 - i\n    vo = k.getValueAt(f, o)\n    v = k.getValueAt(f, i) - d\n    k.setValueAt(v, f, i)\n    k.setValueAt(vo, f, o)\nelse:\n    k.setValue(k.value(i) - d, i)"}
