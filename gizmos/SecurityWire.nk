# SecurityWire -- procedural diamond wire mesh texture (wired glass / security window)   (target: Nuke 16)
# Import: nuke.nodePaste("<path>/SecurityWire.nk"), File > Import Script, or paste
#         this text into the Node Graph. NOT a .gizmo -- it will not be in the toolbar.
# Input : none (generator). Set the format on the node.
# Output: rgb = textured mesh, alpha = wire mask (use it to drive glass/refraction etc).
# Tested: built and rendered headless in Nuke 16.1v4.
# Generated by python/build_security_wire.py -- edit the script, not this file.
set cut_paste_input [stack 0]
version 16.1 v4
Group {
 inputs 0
 name SecurityWire
 tile_color 0x5a6262ff
 selected true
 addUserKnob {20 tab_wire l SecurityWire}
 addUserKnob {41 format T Constant1.format}
 addUserKnob {26 div_shape l Pattern}
 addUserKnob {7 spacing l "cell size" t "Distance in pixels between parallel wires." R 4 400}
 spacing 80
 addUserKnob {7 opening l "diamond angle" t "Angle between the two wire families. 90 = square diamonds, lower = taller diamonds." R 20 160}
 opening 90
 addUserKnob {7 rotate t "Rotates the whole mesh." R -180 180}
 addUserKnob {12 center l offset t "Slides the mesh (pixels)."}
 addUserKnob {7 wire_width l "wire width" t "Wire thickness in pixels." R 0 20}
 wire_width 3
 addUserKnob {7 softness t "Edge falloff of the wire in pixels (antialiasing)." R 0 10}
 softness 0.9
 addUserKnob {26 div_look l Look}
 addUserKnob {19 bg_color l background}
 bg_color {0.1 0.11 0.11 1}
 addUserKnob {19 wire_color l wire}
 wire_color {0.055 0.06 0.06 1}
 addUserKnob {7 cell_shade l "cell shading" t "Brightens cell centres / darkens near the wires."}
 cell_shade 0.15
 addUserKnob {12 shadow_offset l "shadow offset"}
 shadow_offset {1.5 -1.5}
 addUserKnob {7 shadow_soft l "shadow softness" R 0 20}
 shadow_soft 2.5
 addUserKnob {7 shadow_opacity l "shadow opacity"}
 shadow_opacity 0.35
 addUserKnob {7 highlight l "rim highlight" t "Light edge on the side of the wire facing away from the shadow." R 0 0.5}
 highlight 0.03
 addUserKnob {7 grain t "Multiplicative per-pixel noise."}
 grain 0.08
 addUserKnob {7 grain_seed l "grain seed" t "Animate (e.g. =frame) for boiling grain." R 0 100}
}
 Constant {
  inputs 0
  color {0 0 0 0}
  name Constant1
 }
 Expression {
  temp_name0 u
  temp_expr0 (x+0.5-parent.center.x)*cos(radians(parent.rotate+parent.opening/2))+(y+0.5-parent.center.y)*sin(radians(parent.rotate+parent.opening/2))
  temp_name1 v
  temp_expr1 (x+0.5-parent.center.x)*cos(radians(parent.rotate+180-parent.opening/2))+(y+0.5-parent.center.y)*sin(radians(parent.rotate+180-parent.opening/2))
  temp_name2 su
  temp_expr2 parent.shadow_offset.x*cos(radians(parent.rotate+parent.opening/2))+parent.shadow_offset.y*sin(radians(parent.rotate+parent.opening/2))
  temp_name3 sv
  temp_expr3 parent.shadow_offset.x*cos(radians(parent.rotate+180-parent.opening/2))+parent.shadow_offset.y*sin(radians(parent.rotate+180-parent.opening/2))
  expr0 max((1-smoothstep((parent.wire_width/2)-max(parent.softness,0.01),(parent.wire_width/2)+max(parent.softness,0.01),abs((u)-parent.spacing*floor((u)/parent.spacing+0.5)))),(1-smoothstep((parent.wire_width/2)-max(parent.softness,0.01),(parent.wire_width/2)+max(parent.softness,0.01),abs((v)-parent.spacing*floor((v)/parent.spacing+0.5)))))
  expr1 max((1-smoothstep((parent.wire_width/2)-max(parent.shadow_soft,0.01),(parent.wire_width/2)+max(parent.shadow_soft,0.01),abs((u-su)-parent.spacing*floor((u-su)/parent.spacing+0.5)))),(1-smoothstep((parent.wire_width/2)-max(parent.shadow_soft,0.01),(parent.wire_width/2)+max(parent.shadow_soft,0.01),abs((v-sv)-parent.spacing*floor((v-sv)/parent.spacing+0.5)))))
  expr2 max(clamp((1-smoothstep((parent.wire_width/2)-max(parent.softness,0.01),(parent.wire_width/2)+max(parent.softness,0.01),abs((u+su)-parent.spacing*floor((u+su)/parent.spacing+0.5))))-(1-smoothstep((parent.wire_width/2)-max(parent.softness,0.01),(parent.wire_width/2)+max(parent.softness,0.01),abs((u)-parent.spacing*floor((u)/parent.spacing+0.5)))),0,1),clamp((1-smoothstep((parent.wire_width/2)-max(parent.softness,0.01),(parent.wire_width/2)+max(parent.softness,0.01),abs((v+sv)-parent.spacing*floor((v+sv)/parent.spacing+0.5))))-(1-smoothstep((parent.wire_width/2)-max(parent.softness,0.01),(parent.wire_width/2)+max(parent.softness,0.01),abs((v)-parent.spacing*floor((v)/parent.spacing+0.5)))),0,1))
  expr3 clamp(min(abs((u)-parent.spacing*floor((u)/parent.spacing+0.5)),abs((v)-parent.spacing*floor((v)/parent.spacing+0.5)))/(parent.spacing/2),0,1)
  name Wire_masks
 }
 Expression {
  temp_name0 gr
  temp_expr0 1+parent.grain*(random(x,y,parent.grain_seed)-0.5)
  expr0 ((parent.bg_color.r*(1+parent.cell_shade*(a-0.5))*(1-parent.shadow_opacity*g)+parent.highlight*b)*(1-r)+parent.wire_color.r*r)*gr
  expr1 ((parent.bg_color.g*(1+parent.cell_shade*(a-0.5))*(1-parent.shadow_opacity*g)+parent.highlight*b)*(1-r)+parent.wire_color.g*r)*gr
  expr2 ((parent.bg_color.b*(1+parent.cell_shade*(a-0.5))*(1-parent.shadow_opacity*g)+parent.highlight*b)*(1-r)+parent.wire_color.b*r)*gr
  expr3 r
  name Wire_shade
 }
 Output {
  name Output1
 }
end_group
