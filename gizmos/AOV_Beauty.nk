push $N1132c000
add_layer {diffuse_indirect diffuse_indirect.red diffuse_indirect.green diffuse_indirect.blue}
 Shuffle {
  in diffuse_indirect
  name Sh_diffuse_indirect
  xpos 110
 }
 Grade {
  name Grade_diffuse_indirect
  xpos 110
  ypos 60
 }
 ColorCorrect {
  name CC_diffuse_indirect
  xpos 110
