 }
push $N1132c000
add_layer {diffuse_direct diffuse_direct.red diffuse_direct.green diffuse_direct.blue}
 Shuffle {
  in diffuse_direct
  name Sh_diffuse_direct
  xpos 0
 }
 Grade {
  name Grade_diffuse_direct
  xpos 0
  ypos 60
 }
 ColorCorrect {
  name CC_diffuse_direct
  xpos 0
  ypos 120
 }
 Multiply {
  value {{parent.diffuse_direct_on}}
  name Gate_diffuse_direct
 }
 Merge2 {
  inputs 2
  operation plus
  Achannels rgb
  Bchannels rgb
  output rgb
  mix {{parent.diffuse_indirect_on}}
  name Add_diffuse_indirect
 }
 Merge2 {
  inputs 2
  operation multiply
  Achannels rgb
  Bchannels rgb
  output rgb
  mix {{parent.albedo_on}}
