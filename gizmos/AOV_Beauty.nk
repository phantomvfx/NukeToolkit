# AOV_Beauty -- beauty rebuild from light-path AOVs with per-AOV grading   (target: Nuke 16)
# Import: nuke.nodePaste("<path>/AOV_Beauty.nk"), File > Import Script, or paste
#         this text into the Node Graph. NOT a .gizmo -- it will not be in the toolbar.
# Input : EXR with layers diffuse_direct, diffuse_indirect, albedo, specular_direct,
#         specular_indirect, coat, sheen, sss, transmission, emission, volume_direct,
#         volume_indirect (+ RGBA_default for the difference check).
# Output: input with rgba replaced by the rebuilt beauty (see "view" on the Check tab).
# Generated by python/build_aov_beauty.py -- edit the script, not this file.
set cut_paste_input [stack 0]
version 16.1 v4
push $cut_paste_input
Group {
 name AOV_Beauty
 selected true
 addUserKnob {20 tab_master l Master}
 addUserKnob {41 master_gain l gain T AOV_Beauty.Grade_master.multiply}
 addUserKnob {41 master_offset l offset T AOV_Beauty.Grade_master.add}
 addUserKnob {41 master_gamma l gamma T AOV_Beauty.Grade_master.gamma}
 addUserKnob {41 master_sat l saturation T AOV_Beauty.CC_master.saturation}
 addUserKnob {41 master_contrast l contrast T AOV_Beauty.CC_master.contrast}
 addUserKnob {20 tab_aov l AOVs}
 addUserKnob {26 hdr_diffuse_direct l "Diffuse direct"}
 addUserKnob {6 diffuse_direct_on l enable -STARTLINE}
 diffuse_direct_on true
 addUserKnob {41 diffuse_direct_mult l gain T AOV_Beauty.Grade_diffuse_direct.multiply}
 addUserKnob {41 diffuse_direct_add l offset T AOV_Beauty.Grade_diffuse_direct.add}
 addUserKnob {41 diffuse_direct_gamma l gamma T AOV_Beauty.Grade_diffuse_direct.gamma}
 addUserKnob {41 diffuse_direct_sat l saturation T AOV_Beauty.CC_diffuse_direct.saturation}
 addUserKnob {26 hdr_diffuse_indirect l "Diffuse indirect"}
 addUserKnob {6 diffuse_indirect_on l enable -STARTLINE}
 diffuse_indirect_on true
 addUserKnob {41 diffuse_indirect_mult l gain T AOV_Beauty.Grade_diffuse_indirect.multiply}
 addUserKnob {41 diffuse_indirect_add l offset T AOV_Beauty.Grade_diffuse_indirect.add}
 addUserKnob {41 diffuse_indirect_gamma l gamma T AOV_Beauty.Grade_diffuse_indirect.gamma}
 addUserKnob {41 diffuse_indirect_sat l saturation T AOV_Beauty.CC_diffuse_indirect.saturation}
 addUserKnob {26 hdr_albedo l "Multiply diffuse by albedo (OFF for Arnold)"}
 addUserKnob {6 albedo_on l enable -STARTLINE}
 addUserKnob {41 albedo_mult l gain T AOV_Beauty.Grade_albedo.multiply}
 addUserKnob {41 albedo_add l offset T AOV_Beauty.Grade_albedo.add}
 addUserKnob {41 albedo_gamma l gamma T AOV_Beauty.Grade_albedo.gamma}
 addUserKnob {41 albedo_sat l saturation T AOV_Beauty.CC_albedo.saturation}
 addUserKnob {26 hdr_specular_direct l "Specular direct"}
 addUserKnob {6 specular_direct_on l enable -STARTLINE}
 specular_direct_on true
 addUserKnob {41 specular_direct_mult l gain T AOV_Beauty.Grade_specular_direct.multiply}
 addUserKnob {41 specular_direct_add l offset T AOV_Beauty.Grade_specular_direct.add}
 addUserKnob {41 specular_direct_gamma l gamma T AOV_Beauty.Grade_specular_direct.gamma}
 addUserKnob {41 specular_direct_sat l saturation T AOV_Beauty.CC_specular_direct.saturation}
 addUserKnob {26 hdr_specular_indirect l "Specular indirect"}
 addUserKnob {6 specular_indirect_on l enable -STARTLINE}
 specular_indirect_on true
 addUserKnob {41 specular_indirect_mult l gain T AOV_Beauty.Grade_specular_indirect.multiply}
 addUserKnob {41 specular_indirect_add l offset T AOV_Beauty.Grade_specular_indirect.add}
 addUserKnob {41 specular_indirect_gamma l gamma T AOV_Beauty.Grade_specular_indirect.gamma}
 addUserKnob {41 specular_indirect_sat l saturation T AOV_Beauty.CC_specular_indirect.saturation}
 addUserKnob {26 hdr_coat l Coat}
 addUserKnob {6 coat_on l enable -STARTLINE}
 coat_on true
 addUserKnob {41 coat_mult l gain T AOV_Beauty.Grade_coat.multiply}
 addUserKnob {41 coat_add l offset T AOV_Beauty.Grade_coat.add}
 addUserKnob {41 coat_gamma l gamma T AOV_Beauty.Grade_coat.gamma}
 addUserKnob {41 coat_sat l saturation T AOV_Beauty.CC_coat.saturation}
 addUserKnob {26 hdr_sheen l Sheen}
 addUserKnob {6 sheen_on l enable -STARTLINE}
 sheen_on true
 addUserKnob {41 sheen_mult l gain T AOV_Beauty.Grade_sheen.multiply}
 addUserKnob {41 sheen_add l offset T AOV_Beauty.Grade_sheen.add}
 addUserKnob {41 sheen_gamma l gamma T AOV_Beauty.Grade_sheen.gamma}
 addUserKnob {41 sheen_sat l saturation T AOV_Beauty.CC_sheen.saturation}
 addUserKnob {26 hdr_sss l SSS}
 addUserKnob {6 sss_on l enable -STARTLINE}
 sss_on true
 addUserKnob {41 sss_mult l gain T AOV_Beauty.Grade_sss.multiply}
 addUserKnob {41 sss_add l offset T AOV_Beauty.Grade_sss.add}
 addUserKnob {41 sss_gamma l gamma T AOV_Beauty.Grade_sss.gamma}
 addUserKnob {41 sss_sat l saturation T AOV_Beauty.CC_sss.saturation}
 addUserKnob {26 hdr_transmission l Transmission}
 addUserKnob {6 transmission_on l enable -STARTLINE}
 transmission_on true
 addUserKnob {41 transmission_mult l gain T AOV_Beauty.Grade_transmission.multiply}
 addUserKnob {41 transmission_add l offset T AOV_Beauty.Grade_transmission.add}
 addUserKnob {41 transmission_gamma l gamma T AOV_Beauty.Grade_transmission.gamma}
 addUserKnob {41 transmission_sat l saturation T AOV_Beauty.CC_transmission.saturation}
 addUserKnob {26 hdr_emission l Emission}
 addUserKnob {6 emission_on l enable -STARTLINE}
 emission_on true
 addUserKnob {41 emission_mult l gain T AOV_Beauty.Grade_emission.multiply}
 addUserKnob {41 emission_add l offset T AOV_Beauty.Grade_emission.add}
 addUserKnob {41 emission_gamma l gamma T AOV_Beauty.Grade_emission.gamma}
 addUserKnob {41 emission_sat l saturation T AOV_Beauty.CC_emission.saturation}
 addUserKnob {26 hdr_volume_direct l "Volume direct"}
 addUserKnob {6 volume_direct_on l enable -STARTLINE}
 volume_direct_on true
 addUserKnob {41 volume_direct_mult l gain T AOV_Beauty.Grade_volume_direct.multiply}
 addUserKnob {41 volume_direct_add l offset T AOV_Beauty.Grade_volume_direct.add}
 addUserKnob {41 volume_direct_gamma l gamma T AOV_Beauty.Grade_volume_direct.gamma}
 addUserKnob {41 volume_direct_sat l saturation T AOV_Beauty.CC_volume_direct.saturation}
 addUserKnob {26 hdr_volume_indirect l "Volume indirect"}
 addUserKnob {6 volume_indirect_on l enable -STARTLINE}
 volume_indirect_on true
 addUserKnob {41 volume_indirect_mult l gain T AOV_Beauty.Grade_volume_indirect.multiply}
 addUserKnob {41 volume_indirect_add l offset T AOV_Beauty.Grade_volume_indirect.add}
 addUserKnob {41 volume_indirect_gamma l gamma T AOV_Beauty.Grade_volume_indirect.gamma}
 addUserKnob {41 volume_indirect_sat l saturation T AOV_Beauty.CC_volume_indirect.saturation}
 addUserKnob {20 tab_check l Check}
 addUserKnob {4 view M {rebuilt "original (RGBA_default)" "difference (x gain)" "input untouched"}}
 addUserKnob {7 diff_gain l "difference gain"}
 diff_gain 10
 addUserKnob {26 check_hint l "" +STARTLINE T "Difference = |rebuilt - RGBA_default|. Black = the rebuild matches. albedoColor / direct / indirect / shw_all are not part of the sum."}
}
 Input {
  inputs 0
  name src
 }
set N1132c000 [stack 0]
push $N1132c000
push $N1132c000
add_layer {volume_indirect volume_indirect.red volume_indirect.green volume_indirect.blue}
 Shuffle {
  in volume_indirect
  name Sh_volume_indirect
  xpos 1210
 }
 Grade {
  name Grade_volume_indirect
  xpos 1210
  ypos 60
 }
 ColorCorrect {
  name CC_volume_indirect
  xpos 1210
  ypos 120
 }
push $N1132c000
add_layer {volume_direct volume_direct.red volume_direct.green volume_direct.blue}
