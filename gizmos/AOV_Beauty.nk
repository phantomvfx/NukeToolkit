 }
 Grade {
  name Grade_master
 }
 ColorCorrect {
  name CC_master
 }
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 rgba.alpha
  name Alpha_from_src
 }
set N4011ca00 [stack 0]
push $N1132c000
add_layer {RGBA_default RGBA_default.red RGBA_default.green RGBA_default.blue RGBA_default.alpha}
 Shuffle {
  in RGBA_default
  name Sh_original
 }
set N4011cf00 [stack 0]
 Merge2 {
