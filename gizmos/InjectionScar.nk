# InjectionScar -- procedural needle / injection mark: puncture, redness ring, bruise halo   (target: Nuke 16)
# Inputs : src = the skin plate (rgba). Nothing else.
# Output : the plate with the mark graded in. Tick "show matte" to see the masks
#          (r = puncture, g = redness, b = inner bruise, a = outer bruise).
# Target : Nuke 16
# Import : NOT a .gizmo. Paste this text into the Node Graph, or use File > Import Script,
#          or nuke.nodePaste("<path>/InjectionScar.nk"). It will not be in the node toolbar.
# Use    : connect the plate, drag "position" onto the skin (or link it to a Tracker), then
#          dial size / bruise to taste. Sizes are in plate pixels.
# Status : python/smoke_injection_scar.py passes headless in Nuke 16.1v4 (synthetic plate + a real skin still).
#          Not yet checked in the GUI or pasted through the clipboard. 16.0+ expected, verified in 16.1v4.
#          The colour tints are plain multiplies: tuned on an sRGB-viewed plate, retune for a very different grade.
# Generated by python/build_injection_scar.py -- edit the script, not this file.
set cut_paste_input [stack 0]
version 16.1 v4
push $cut_paste_input
Group {
 name InjectionScar
 tile_color 0x8a4a4aff
 selected true
 addUserKnob {20 tab_scar l InjectionScar}
 addUserKnob {12 center l position t "Where the needle went in (plate pixels). Link to a Tracker to follow the skin."}
 center {100 100}
 addUserKnob {7 amount t "Overall strength of every layer. 0 = untouched plate."}
 amount 1
 addUserKnob {26 div_punct l Puncture}
 addUserKnob {7 size l "size (px)" t "Radius of the puncture itself, in plate pixels." R 0.3 30}
 size 2.5
 addUserKnob {7 stretch t "1 = round. Above 1 elongates the mark along 'angle' (an angled needle entry)." R 0.3 4}
 stretch 1
 addUserKnob {7 angle t "Direction of the stretch, degrees." R -180 180}
 addUserKnob {18 core_color l "core colour" t "Multiplied over the plate inside the puncture. Pale (0.8,0.6,0.55) reads as an old healed scar."}
 core_color {0.35 0.13 0.11}
 addUserKnob {7 core_opacity l "core opacity"}
 core_opacity 0.85
 addUserKnob {18 redness_color l "redness colour" t "Inflamed ring around the puncture."}
 redness_color {1 0.62 0.58}
 addUserKnob {7 redness_opacity l "redness opacity"}
 redness_opacity 0.5
 addUserKnob {7 redness_spread l "redness spread" t "Redness radius as a multiple of the puncture size." R 1 12}
 redness_spread 4
 addUserKnob {26 div_bruise l "Bruise halo"}
 addUserKnob {7 bruise_size l "bruise size (px)" t "Radius of the inner bruise, in plate pixels." R 0 200}
 bruise_size 22
 addUserKnob {18 bruise_color l "bruise colour" t "Inner bruise: blue / purple."}
 bruise_color {0.62 0.5 0.7}
 addUserKnob {7 bruise_opacity l "bruise opacity" t "0 = no bruise (fresh or old clean scar)."}
 bruise_opacity 0.45
 addUserKnob {18 outer_color l "outer colour" t "Wider fringe, yellow / green. It is the 'older bruise' look."}
 outer_color {0.86 0.88 0.52}
 addUserKnob {7 outer_opacity l "outer opacity"}
 outer_opacity 0.3
 addUserKnob {26 div_break l Breakup}
 addUserKnob {7 irregularity t "How lumpy the edges are. 0 = perfect circles, which read as CG."}
 irregularity 0.5
 addUserKnob {7 mottle t "Blotchy variation of the bruise density."}
 mottle 0.5
 addUserKnob {7 seed t "Change it for a different shape. Do not animate it." R 0 100}
 addUserKnob {7 soften l "soften (px)" t "Blur on the masks. Raise it to match a soft or out of focus plate." R 0 20}
 soften 0.8
 addUserKnob {6 show_matte l "show matte" -STARTLINE}
}
 Input {
  inputs 0
  name src
 }
set N1ef72000 [stack 0]
 Expression {
  temp_name0 pu
  temp_expr0 (x+0.5-parent.center.x)*cos(radians(parent.angle))+(y+0.5-parent.center.y)*sin(radians(parent.angle))
  temp_name1 pv
  temp_expr1 -(x+0.5-parent.center.x)*sin(radians(parent.angle))+(y+0.5-parent.center.y)*cos(radians(parent.angle))
  temp_name2 d
  temp_expr2 sqrt(pow(pu/max(parent.stretch,0.01),2)+pow(pv*max(parent.stretch,0.01),2))
  temp_name3 db
  temp_expr3 sqrt(pow(pu/pow(max(parent.stretch,0.01),0.3),2)+pow(pv*pow(max(parent.stretch,0.01),0.3),2))
  expr0 max(d*(1+0.35*parent.irregularity*fBm((x+0.5-parent.center.x+0.37)/max(max(parent.size,0.05)+1,1.5),(y+0.5-parent.center.y+0.37)/max(max(parent.size,0.05)+1,1.5),parent.seed+7,2,2,0.5)),0.2*d)
  expr1 max(db*(1+0.7*parent.irregularity*fBm((x+0.5-parent.center.x+0.37)/max(parent.bruise_size*0.6,1),(y+0.5-parent.center.y+0.37)/max(parent.bruise_size*0.6,1),parent.seed+13,4,2,0.5)),0.2*db)
  expr2 clamp(0.5+0.6*fBm((x+0.5-parent.center.x+0.37)/max(parent.bruise_size*0.25,1),(y+0.5-parent.center.y+0.37)/max(parent.bruise_size*0.25,1),parent.seed+29,4,2,0.5),0,1)
  expr3 0
  name Scar_geo
 }
 Expression {
  temp_name0 f
  temp_expr0 max(0.35*max(parent.size,0.05),0.35)
  temp_name1 R
  temp_expr1 max(parent.bruise_size,0.5)
  temp_name2 mo
  temp_expr2 1-parent.mottle+parent.mottle*b
  expr0 1-smoothstep(max(parent.size,0.05)-f,max(parent.size,0.05)+f,r)
  expr1 1-smoothstep(max(parent.size,0.05)*0.5,max(parent.size,0.05)*max(parent.redness_spread,1.01),r)
  expr2 (parent.bruise_size>0)*(1-smoothstep(0.1*R,R,g))*mo
  expr3 (parent.bruise_size>0)*(1-smoothstep(0.55*R,1.6*R,g))*(0.7+0.3*mo)
  name Scar_masks
 }
 Blur {
  channels rgba
  size {{parent.soften}}
  name Scar_soften
 }
set N1ef7aa00 [stack 0]
push $N1ef7aa00
push $N1ef7aa00
push $N1ef7aa00
push $N1ef7aa00
push $N1ef72000
 Grade {
  inputs 1+1
  multiply {{parent.outer_color.r} {parent.outer_color.g} {parent.outer_color.b} 1}
  mix {{parent.amount*parent.outer_opacity}}
  name Scar_outer
 }
 Grade {
  inputs 1+1
  multiply {{parent.bruise_color.r} {parent.bruise_color.g} {parent.bruise_color.b} 1}
  maskChannelMask rgba.blue
  mix {{parent.amount*parent.bruise_opacity}}
  name Scar_bruise
 }
 Grade {
  inputs 1+1
  multiply {{parent.redness_color.r} {parent.redness_color.g} {parent.redness_color.b} 1}
  maskChannelMask rgba.green
  mix {{parent.amount*parent.redness_opacity}}
  name Scar_redness
 }
 Grade {
  inputs 1+1
  multiply {{parent.core_color.r} {parent.core_color.g} {parent.core_color.b} 1}
  maskChannelMask rgba.red
  mix {{parent.amount*parent.core_opacity}}
  name Scar_core
 }
 Switch {
  inputs 2
  which {{parent.show_matte}}
  name Scar_view
 }
 Output {
  name Output1
 }
end_group
