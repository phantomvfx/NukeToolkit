# AOV_CameraData -- camera-data utility group   (target: Nuke 16)
# Import: nuke.nodePaste("<path>/AOV_CameraData.nk"), File > Import Script, or paste
#         this text into the Node Graph. NOT a .gizmo -- it will not be in the toolbar.
# Input : an image carrying depth / N / P (/ Pref) layers (camera-data pass).
# Output: input + depth.Z (1/distance, ZDefocus "far=0"), maskN.alpha, maskP.alpha.
# Generated by python/build_aov_cameradata.py -- edit the script, not this file.
set cut_paste_input [stack 0]
version 16.1 v4
push $cut_paste_input
add_layer {N N.red N.green N.blue}
add_layer {P P.red P.green P.blue}
Group {
 name AOV_CameraData
 selected true
 addUserKnob {20 tab_in l Inputs}
 addUserKnob {41 depth_in l "depth channel" T AOV_CameraData.Depth_select.from0}
 addUserKnob {11 n_layer l "normal layer"}
 n_layer N
 addUserKnob {11 p_layer l "position layer"}
 p_layer P
 addUserKnob {26 in_hint l "" +STARTLINE T "Position/normal layers must use .red/.green/.blue channels (Nuke's default for R,G,B EXR channels)."}
 addUserKnob {6 do_reformat l "reformat (impulse filter)" -STARTLINE}
 addUserKnob {17 fmt l "output format"}
 addUserKnob {26 ref_hint l "" +STARTLINE T "Utility passes must never be filtered: impulse keeps depth/N/P values unblended on resize."}
 addUserKnob {20 tab_depth l Depth}
 addUserKnob {4 depth_mode l "input is" M {"distance (convert to 1/z)" "already 1/z (pass through)"}}
 addUserKnob {7 depth_scale l "scene scale"}
 depth_scale 1
 addUserKnob {7 bg_max l "background >="}
 bg_max 1000000000
 addUserKnob {26 depth_hint l "" +STARTLINE T "Output depth.Z = 1/(z*scale). 0 = infinity (background). In ZDefocus: depth channel depth.Z, math = far=0."}
 addUserKnob {20 tab_n l "Normal mask"}
 addUserKnob {13 n_dir l direction}
 n_dir {0 1 0}
 addUserKnob {22 n_py l +Y -STARTLINE T "nuke.thisNode()\['n_dir'].setValue(\[0, 1, 0])"}
 addUserKnob {22 n_p_mY l -Y -STARTLINE T "nuke.thisNode()\['n_dir'].setValue(\[0, -1, 0])"}
 addUserKnob {22 n_p_pX l +X -STARTLINE T "nuke.thisNode()\['n_dir'].setValue(\[1, 0, 0])"}
 addUserKnob {22 n_p_mX l -X -STARTLINE T "nuke.thisNode()\['n_dir'].setValue(\[-1, 0, 0])"}
 addUserKnob {22 n_p_pZ l +Z -STARTLINE T "nuke.thisNode()\['n_dir'].setValue(\[0, 0, 1])"}
 addUserKnob {22 n_p_mZ l -Z -STARTLINE T "nuke.thisNode()\['n_dir'].setValue(\[0, 0, -1])"}
 addUserKnob {7 n_angle l "angle (deg)"}
 n_angle 30
 addUserKnob {7 n_soft l "softness (deg)"}
 n_soft 15
 addUserKnob {6 n_invert l invert -STARTLINE}
 addUserKnob {20 tab_p l "Position mask"}
 addUserKnob {4 p_shape l shape M {sphere box}}
 addUserKnob {13 p_center l center}
 addUserKnob {7 p_radius l "radius (sphere)"}
 p_radius 100
 addUserKnob {13 p_size l "half size (box)"}
 p_size {100 100 100}
 addUserKnob {7 p_falloff l falloff}
 p_falloff 20
 addUserKnob {6 p_invert l invert -STARTLINE}
 addUserKnob {12 p_pick l "pick pixel"}
 addUserKnob {22 p_pick_btn l "set center from pixel" -STARTLINE T "n = nuke.thisNode()\nL = n\['p_layer'].value()\nx, y = n\['p_pick'].value()\nsrc = n.input(0)\nn\['p_center'].setValue(\[src.sample(L + '.' + c, x, y) for c in ('red', 'green', 'blue')])\n"}
 addUserKnob {20 tab_out l Output}
 addUserKnob {4 view l "view in rgba" M {off "normal mask" "position mask" "depth (1/z, x gain)"}}
 addUserKnob {7 view_gain l "depth view gain"}
 view_gain 1
}
 Input {
  inputs 0
  name src
 }
 Reformat {
  format {{{parent.fmt}}}
  filter impulse
  name Reformat_impulse
  disable {{!parent.do_reformat}}
 }
set N2f23c500 [stack 0]
push $N2f23c500
 Copy {
  inputs 2
  from0 depth.Z
  to0 depth.Z
  name Depth_select
 }
 Expression {
  channel0 depth
  expr0 "parent.depth_mode == 0 ? ((depth.Z > 0 && depth.Z < parent.bg_max) ? 1/(depth.Z * parent.depth_scale) : 0) : ((depth.Z > 0 && depth.Z < parent.bg_max) ? depth.Z : 0)"
  channel1 none
  channel2 none
  channel3 none
  name Depth_to_1overZ
 }
add_layer {maskN maskN.alpha}
 Expression {
  channel0 maskN
  expr0 "abs(parent.n_invert - clamp(((\[value parent.n_layer].red*parent.n_dir.x + \[value parent.n_layer].green*parent.n_dir.y + \[value parent.n_layer].blue*parent.n_dir.z) / max(sqrt(\[value parent.n_layer].red*\[value parent.n_layer].red + \[value parent.n_layer].green*\[value parent.n_layer].green + \[value parent.n_layer].blue*\[value parent.n_layer].blue), 1e-6) / max(sqrt(parent.n_dir.x*parent.n_dir.x + parent.n_dir.y*parent.n_dir.y + parent.n_dir.z*parent.n_dir.z), 1e-6) - cos(radians(min(parent.n_angle + parent.n_soft, 180)))) / max(cos(radians(parent.n_angle)) - cos(radians(min(parent.n_angle + parent.n_soft, 180))), 1e-6)))"
  channel1 none
  channel2 none
  channel3 none
  name NormalMask
 }
add_layer {maskP maskP.alpha}
 Expression {
  channel0 maskP
  expr0 "parent.p_shape == 0 ? (sqrt((\[value parent.p_layer].red - parent.p_center.x)*(\[value parent.p_layer].red - parent.p_center.x) + (\[value parent.p_layer].green - parent.p_center.y)*(\[value parent.p_layer].green - parent.p_center.y) + (\[value parent.p_layer].blue - parent.p_center.z)*(\[value parent.p_layer].blue - parent.p_center.z)) - parent.p_radius) : max(abs(\[value parent.p_layer].red - parent.p_center.x) - parent.p_size.x, max(abs(\[value parent.p_layer].green - parent.p_center.y) - parent.p_size.y, abs(\[value parent.p_layer].blue - parent.p_center.z) - parent.p_size.z))"
  channel1 none
  channel2 none
  channel3 none
  name PosSDF
 }
 Expression {
  channel0 maskP
  expr0 "abs(parent.p_invert - (1 - clamp(maskP.alpha / max(parent.p_falloff, 1e-6))))"
  channel1 none
  channel2 none
  channel3 none
  name PositionMask
 }
 Expression {
  channel0 {rgba.red -rgba.green -rgba.blue none}
  expr0 "parent.view == 1 ? maskN.alpha : parent.view == 2 ? maskP.alpha : depth.Z * parent.view_gain"
  channel1 {-rgba.red rgba.green -rgba.blue none}
  expr1 "parent.view == 1 ? maskN.alpha : parent.view == 2 ? maskP.alpha : depth.Z * parent.view_gain"
  channel2 {-rgba.red -rgba.green rgba.blue none}
  expr2 "parent.view == 1 ? maskN.alpha : parent.view == 2 ? maskP.alpha : depth.Z * parent.view_gain"
  channel3 none
  name View
  disable {{"parent.view == 0"}}
 }
 Output {
  name Output1
 }
end_group
